@model OpdAccrRptWeb.ViewModels.C7PreviewViewModel
<h1>門急診每日批價明細表</h1><div class="report-preview-meta"><span>使用者：@Model.LoginUserId</span><span>@Model.DataTime @Model.DataTime1 ～ @Model.DataTime2 @Model.DataTime3</span><span>列印時間：@Model.NowTime</span></div><table class="report-preview-table"><thead><tr><th>日期</th><th>時段</th><th>科別</th><th>診別</th><th>狀態</th><th>批價碼</th><th>名稱</th><th>單價</th><th>數量</th><th>金額</th><th>病歷號</th><th>身分</th><th>輸入者</th><th>輸入者姓名</th></tr></thead><tbody>@foreach(var r in Model.Rows){<tr><td>@r.VisitDate</td><td>@r.VisitTime</td><td>@r.SectionCode</td><td>@r.EncounterLabel</td><td>@r.Status</td><td>@r.ChargeCode</td><td>@r.ChargeName</td><td>@r.UnitPrice</td><td>@r.Quantity</td><td>@r.Amount</td><td>@r.MedicalRecordNo</td><td>@r.IdentityCode</td><td>@r.InputUserId</td><td>@r.InputUserName</td></tr>}</tbody></table>
