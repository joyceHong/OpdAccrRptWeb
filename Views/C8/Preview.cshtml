@model OpdAccrRptWeb.ViewModels.C8PreviewViewModel
@using System.Globalization
@{
    const int rowsPerPage = 40;
    var pages = Model.Rows.Chunk(rowsPerPage).ToArray();
}
@for (var pageIndex = 0; pageIndex < pages.Length; pageIndex++)
{
    <article class="report-preview-paper c8-paper">
        <header class="c8-print-header">
            <div class="c8-print-title">
                <div>亞東紀念醫院門診作業</div>
                <div>批價補帳資料核帳明細表</div>
            </div>
            <div class="c8-print-meta">
                <div><div>作業名稱：</div><div>出表日期：@Model.PrintedAt</div></div>
                <div class="c8-print-date">資料日期：@Model.StartDate <span>--</span> @Model.EndDate</div>
                <div class="c8-print-page">頁次：@((pageIndex + 1).ToString("0.00", CultureInfo.InvariantCulture))</div>
            </div>
        </header>
        <table class="c8-print-table">
            <colgroup><col class="date" /><col class="record" /><col class="section" /><col class="identity" /><col class="code" /><col class="name" /><col class="price" /><col class="price" /><col class="quantity" /><col class="amount" /><col class="amount" /><col class="user" /></colgroup>
            <thead><tr><th>就診日期</th><th>病歷號</th><th>科別</th><th>身份</th><th>批價碼</th><th>批價名稱</th><th>單價(健保)</th><th>單價(自費)</th><th>數量</th><th>金額(健保)</th><th>金額(自費)</th><th>建檔人員</th></tr></thead>
            <tbody>
                @foreach (var row in pages[pageIndex])
                {
                    <tr><td>@row.VisitDate</td><td>@row.MedicalRecordNo</td><td>@row.SectionCode</td><td>@row.IdentityCode</td><td>@row.ChargeCode</td><td>@row.ChargeName</td><td class="number">@row.InsuranceUnitPrice.ToString("0.0", CultureInfo.InvariantCulture)</td><td class="number">@row.SelfPayUnitPrice.ToString("0.0", CultureInfo.InvariantCulture)</td><td class="number">@row.Quantity.ToString("0.##", CultureInfo.InvariantCulture)</td><td class="number">@row.InsuranceAmount.ToString("0.0", CultureInfo.InvariantCulture)</td><td class="number">@row.SelfPayAmount.ToString("0.0", CultureInfo.InvariantCulture)</td><td>@row.ChargeUserId</td></tr>
                }
            </tbody>
        </table>
    </article>
}
