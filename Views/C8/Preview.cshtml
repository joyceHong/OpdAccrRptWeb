@model OpdAccrRptWeb.ViewModels.C8PreviewViewModel
<h1>批價補帳資料核帳明細表</h1><div class="report-preview-meta"><span>使用者：@Model.LoginUserId</span><span>@Model.StartDate ～ @Model.EndDate</span><span>列印時間：@Model.PrintedAt</span></div><table class="report-preview-table"><thead><tr><th>日期</th><th>病歷號</th><th>科別</th><th>身分</th><th>輸入者</th><th>批價碼</th><th>名稱</th><th>健保單價</th><th>自費單價</th><th>數量</th><th>健保金額</th><th>自費金額</th></tr></thead><tbody>@{string? group=null;}@foreach(var r in Model.Rows){string key=$"{r.VisitDate}|{r.MedicalRecordNo}";<tr class="@(group != key ? "group-start" : "")"><td>@r.VisitDate</td><td>@r.MedicalRecordNo</td><td>@r.SectionCode</td><td>@r.IdentityCode</td><td>@r.ChargeUserId</td><td>@r.ChargeCode</td><td>@r.ChargeName</td><td>@r.InsuranceUnitPrice</td><td>@r.SelfPayUnitPrice</td><td>@r.Quantity</td><td>@r.InsuranceAmount</td><td>@r.SelfPayAmount</td></tr>group=key;}</tbody></table>
