@model OpdAccrRptWeb.ViewModels.C9PreviewViewModel
<div class="c9-preview">
<section class="c9-print-document c9-summary-report"><header><h1>維康耗材記帳月報表</h1><div class="report-preview-meta"><span>資料日期：@Model.StartDate - @Model.EndDate</span><span>處理時間：@Model.PrintedAt</span><span>編輯者：@Model.LoginUserId</span><span>@Model.ProgramNo</span><span>@Model.ReportNo</span></div></header>
@foreach(var g in Model.Groups){<table class="report-preview-table"><thead><tr><th>收費科目代碼</th><th>收費科目名稱</th><th>總金額</th><th>折扣額</th><th>應付金額</th></tr></thead><tbody>@foreach(var r in g.Rows){<tr><td>@r.ChargeCode</td><td>@r.ChargeName</td><td>@r.TotalAmount</td><td>@r.DiscountAmount</td><td>@r.PayableAmount</td></tr>}</tbody><tfoot><tr class="group-subtotal"><th colspan="2">@g.ChargeCode 小計</th><td>@g.TotalAmount</td><td>@g.DiscountAmount</td><td>@g.PayableAmount</td></tr></tfoot></table>}</section>
<section class="c9-print-document c9-detail-report"><header><h1>維康耗材記帳月報表</h1><div class="report-preview-meta"><span>資料日期：@Model.StartDate - @Model.EndDate</span><span>處理時間：@Model.PrintedAt</span><span>編輯者：@Model.LoginUserId</span><span>@Model.ProgramNo</span><span>@Model.ReportNo</span></div></header>
@foreach(var g in Model.Groups){<table class="report-preview-table"><thead><tr><th>日期</th><th>病歷號</th><th>姓名</th><th>科別</th><th>醫師</th><th>收費科目代碼</th><th>收費科目名稱</th><th>總金額</th><th>折扣額</th><th>應付金額</th><th>記帳員</th></tr></thead><tbody>@foreach(var r in g.Rows){<tr><td>@r.VisitDate</td><td>@r.MedicalRecordNo</td><td>@r.PatientName</td><td>@r.SectionName</td><td>@r.DoctorName</td><td>@r.ChargeCode</td><td>@r.ChargeName</td><td>@r.TotalAmount</td><td>@r.DiscountAmount</td><td>@r.PayableAmount</td><td>@r.ChargeUserId</td></tr>}</tbody><tfoot><tr class="group-subtotal"><th colspan="7">@g.ChargeCode 小計</th><td>@g.TotalAmount</td><td>@g.DiscountAmount</td><td>@g.PayableAmount</td><td></td></tr></tfoot></table>}</section>
</div>
