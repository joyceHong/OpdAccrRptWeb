@model OpdAccrRptWeb.ViewModels.C9PreviewViewModel
@using System.Globalization

<div class="c9-preview">
    <section class="c9-print-document c9-summary-report" aria-label="維康耗材記帳月報表彙總">
        <header class="c9-print-header">
            <div class="c9-header-left">
                <div>列印日期：@Model.PrintedAt</div>
                <div>單位：維康</div>
            </div>
            <div class="c9-header-center">
                <div class="c9-hospital-name">亞東紀念醫院</div>
                <h1>維康耗材記帳月報表</h1>
                <div>資料日期：@Model.StartDate - @Model.EndDate</div>
            </div>
            <div class="c9-header-right">頁數：1</div>
        </header>
        <table class="c9-print-table c9-summary-table">
            <colgroup><col class="item" /><col class="amount" /><col class="amount" /><col class="amount" /></colgroup>
            <thead><tr><th>收　費　科　目</th><th>總金額</th><th>折扣額</th><th>應付金額</th></tr></thead>
            @foreach (var group in Model.Groups)
            {
                <tbody class="c9-group">
                    @foreach (var row in group.Rows)
                    {
                        <tr><td>@row.ChargeCode　@row.ChargeName</td><td class="number">@row.TotalAmount.ToString("0.############################", CultureInfo.InvariantCulture)</td><td class="number">@row.DiscountAmount.ToString("0.############################", CultureInfo.InvariantCulture)</td><td class="number">@row.PayableAmount.ToString("0.############################", CultureInfo.InvariantCulture)</td></tr>
                    }
                    <tr class="c9-group-subtotal group-subtotal"><th>合　計：</th><td class="number">@group.TotalAmount.ToString("0.############################", CultureInfo.InvariantCulture)</td><td class="number">@group.DiscountAmount.ToString("0.############################", CultureInfo.InvariantCulture)</td><td class="number">@group.PayableAmount.ToString("0.############################", CultureInfo.InvariantCulture)</td></tr>
                </tbody>
            }
        </table>
        <footer class="c9-print-footer">製表人：@Model.LoginUserId</footer>
    </section>

    <section class="c9-print-document c9-detail-report" aria-label="維康耗材記帳月報表明細">
        <header class="c9-print-header">
            <div class="c9-header-left">處理日期：@Model.PrintedAt</div>
            <div class="c9-header-center">
                <div class="c9-hospital-name">亞東紀念醫院</div>
                <h1>維康耗材記帳月報表</h1>
                <div>資料日期：@Model.StartDate - @Model.EndDate　　單位：維康</div>
            </div>
            <div class="c9-header-right">頁數：1</div>
        </header>
        <table class="c9-print-table c9-detail-table">
            <colgroup><col class="date" /><col class="record" /><col class="patient" /><col class="section" /><col class="doctor" /><col class="item" /><col class="amount" /><col class="amount" /><col class="amount" /><col class="user" /></colgroup>
            <thead><tr><th>日　期</th><th>病歷號</th><th>姓　名</th><th>科　別</th><th>醫　師</th><th>收　費　科　目</th><th>總金額</th><th>折扣額</th><th>應付金額</th><th>記　帳　員</th></tr></thead>
            @foreach (var group in Model.Groups)
            {
                <tbody class="c9-group">
                    @foreach (var row in group.Rows)
                    {
                        <tr><td>@row.VisitDate</td><td>@row.MedicalRecordNo</td><td>@row.PatientName</td><td>@row.SectionName</td><td>@row.DoctorName</td><td>@row.ChargeCode　@row.ChargeName</td><td class="number">@row.TotalAmount.ToString("0.############################", CultureInfo.InvariantCulture)</td><td class="number">@row.DiscountAmount.ToString("0.############################", CultureInfo.InvariantCulture)</td><td class="number">@row.PayableAmount.ToString("0.############################", CultureInfo.InvariantCulture)</td><td>@row.ChargeUserId</td></tr>
                    }
                    <tr class="c9-group-subtotal group-subtotal"><th colspan="6">合　計：</th><td class="number">@group.TotalAmount.ToString("0.############################", CultureInfo.InvariantCulture)</td><td class="number">@group.DiscountAmount.ToString("0.############################", CultureInfo.InvariantCulture)</td><td class="number">@group.PayableAmount.ToString("0.############################", CultureInfo.InvariantCulture)</td><td></td></tr>
                </tbody>
            }
        </table>
        <footer class="c9-print-footer">製表人：@Model.LoginUserId</footer>
    </section>
</div>
