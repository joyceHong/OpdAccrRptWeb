@model OpdAccrRptWeb.Models.OpdReceiptPreview
@{ Layout = null; }
<!doctype html><html lang="zh-Hant"><head><meta charset="utf-8" /><title>醫療費用收據</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head><body class="q1-receipt-body"><div class="q1-receipt-actions"><button type="button" onclick="window.print()">列印</button><button type="button" onclick="window.close()">關閉</button></div><main class="q1-receipt-paper"><h1>亞東紀念醫院醫療費用收據 @Model.RoomType</h1><dl><dt>收據號</dt><dd>@Model.Header.ReceiptNo</dd><dt>病歷號</dt><dd>@Model.Header.MedicalRecordNo</dd><dt>姓名</dt><dd>@Model.Header.PatientName</dd><dt>就醫日</dt><dd>@Model.Header.VisitDate</dd><dt>科別</dt><dd>@Model.Header.SectionName</dd><dt>醫師</dt><dd>@Model.Header.DoctorName</dd></dl><table><thead><tr><th colspan="3">收費科目</th></tr></thead><tbody>@foreach(var row in Model.ItemRows){<tr>@foreach(var item in row){<td>@item.Name　健保 @item.InsuranceAmount　自費 @item.SelfPayAmount</td>}@for(int i=row.Count;i<3;i++){<td></td>}</tr>}</tbody></table><div class="q1-receipt-totals"><span>總醫療費 @Model.Total</span><span>健保 @Model.Insurance</span><span>自付 @Model.SelfPay</span><span>優待 @Model.Discount</span><span>補助 @Model.Subsidy</span><span>實收 @Model.Collected</span><span>餘額 @Model.Balance</span><span>中文實收額 @Model.ChineseCollected</span></div></main></body></html>
