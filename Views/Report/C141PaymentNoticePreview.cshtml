@using System.Globalization
@model OpdAccrRptWeb.ViewModels.C141NoticePreviewPage
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>C141 住院費用通知單預覽</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; color: #111; background: #edf1f5; font-family: "PMingLiU", "Noto Serif TC", serif; }
        .c141-preview-results { max-width: 1040px; margin: 20px auto; padding: 0 12px; }
        .c141-preview-result { margin: 0 0 14px; padding: 12px 16px; border: 1px solid #d4dde6; border-radius: 6px; background: #fff; }
        .c141-preview-result strong { margin-right: 8px; }
        .c141-payment-notice { width: 210mm; min-height: 297mm; margin: 18px auto; padding: 15mm 10mm; background: #fff; box-shadow: 0 8px 28px #0003; break-after: page; font-size: 12px; }
        .c141-payment-notice:last-child { break-after: auto; }
        .c141-notice-header { width: 92%; margin: 0 auto 6mm; text-align: center; }
        .c141-notice-header h1, .c141-notice-header h2, .c141-notice-header p { margin: 0; border: 1px solid #888; font-weight: 400; }
        .c141-notice-header h1 { font-size: 20px; line-height: 1.5; white-space: nowrap; }
        .c141-notice-header h2 { font-size: 22px; line-height: 1.45; border-top: 0; }
        .c141-notice-header p { font-size: 17px; line-height: 1.5; border-top: 0; white-space: nowrap; }
        .c141-payment-notice table { width: 100%; border-collapse: collapse; table-layout: fixed; }
        .c141-payment-notice th, .c141-payment-notice td { border: 1px solid #333; padding: 2px 4px; font-weight: 400; vertical-align: middle; overflow-wrap: anywhere; }
        .c141-notice-patient { margin-bottom: 3mm; font-size: 13px; }
        .c141-notice-patient th { width: 12%; text-align: center; white-space: nowrap; }
        .c141-notice-patient td { width: 22%; }
        .c141-notice-details { margin-bottom: 11mm; font-size: 12px; }
        .c141-notice-details thead th { text-align: center; white-space: nowrap; }
        .c141-notice-details thead th:nth-child(1), .c141-notice-details thead th:nth-child(4) { width: 27%; }
        .c141-notice-details thead th:nth-child(2), .c141-notice-details thead th:nth-child(3), .c141-notice-details thead th:nth-child(5), .c141-notice-details thead th:nth-child(6) { width: 11.5%; }
        .c141-notice-details .amount, .c141-notice-totals td { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
        .c141-notice-details .c141-notice-empty { text-align: center; }
        .c141-notice-subtotal th { text-align: right; }
        .c141-notice-totals { font-size: 12px; }
        .c141-notice-totals th { text-align: center; }
        .c141-notice-totals th:nth-child(2n+1) { width: 16%; }
        .c141-notice-notes { margin-top: 1mm; font-size: 11px; line-height: 1.3; }
        .c141-notice-notes div, .c141-notice-notes p { margin: 0; padding: 2px 3px; border-bottom: 1px dotted #bbb; }
        .c141-notice-alert { font-size: 15px; }
        .c141-notice-footer { margin-top: 15mm; text-align: right; font-size: 11px; }
        @@media screen {
            html:has(body.c141-embedded), body.c141-embedded { overflow: hidden; }
            body.c141-embedded .c141-payment-notice { margin: 0 auto; box-shadow: none; }
            body.c141-embedded .c141-preview-results { margin: 0 auto; }
        }
        @@media print {
            body { background: #fff; }
            .c141-preview-results { display: none !important; }
            .c141-payment-notice[hidden] { display: block !important; }
            .c141-payment-notice { margin: 0; padding: 8mm 6mm; box-shadow: none; }
            @@page { size: A4 portrait; margin: 0; }
        }
        @@media screen and (max-width: 700px) {
            .c141-payment-notice { margin: 10px; }
        }
    </style>
</head>
<body>
    @if (Model.Items.Any(item => item.Status != "成功"))
    {
    <main class="c141-preview-results">
        @foreach (var item in Model.Items.Where(item => item.Status != "成功"))
        {
            <div class="c141-preview-result">
                <strong>@item.Status</strong>
                <span>@item.Key.AdmissionDate / @item.Key.AdmissionRoom / @item.Key.AdmissionNumber.ToString(CultureInfo.InvariantCulture)</span>
                <span>— @item.Message</span>
            </div>
        }
    </main>
    }
    @foreach (var item in Model.Items.Where(item => item.Html is not null))
    {
        @Html.Raw(item.Html)
    }
</body>
</html>
