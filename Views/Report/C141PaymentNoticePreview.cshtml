@using System.Globalization
@model OpdAccrRptWeb.ViewModels.C141NoticePreviewPage
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>C141 住院費用通知單預覽</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; color: #202b38; background: #edf1f5; font-family: "Microsoft JhengHei", sans-serif; }
        .no-print { position: sticky; z-index: 2; top: 0; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 12px 20px; color: #fff; background: #173f63; }
        .no-print button { padding: 8px 16px; border: 1px solid #fff; border-radius: 4px; color: #173f63; background: #fff; font: inherit; cursor: pointer; }
        .c141-preview-results { max-width: 1040px; margin: 20px auto; padding: 0 12px; }
        .c141-preview-result { margin: 0 0 14px; padding: 12px 16px; border: 1px solid #d4dde6; border-radius: 6px; background: #fff; }
        .c141-preview-result strong { margin-right: 8px; }
        .c141-payment-notice { max-width: 1040px; margin: 18px auto; padding: 30px 34px; border: 1px solid #aeb9c6; background: #fff; break-after: page; }
        .c141-notice-header { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 20px; padding-bottom: 10px; border-bottom: 2px solid #27394b; font-size: 18px; font-weight: 700; }
        .c141-notice-header span + span { font-size: 13px; }
        .c141-notice-patient { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px 16px; margin-bottom: 18px; }
        .c141-notice-patient div { display: flex; gap: 7px; min-width: 0; font-size: 13px; }
        .c141-notice-patient strong { flex: 0 0 auto; }
        .c141-payment-notice table { width: 100%; border-collapse: collapse; font-size: 13px; }
        .c141-payment-notice th, .c141-payment-notice td { padding: 6px 8px; border: 1px solid #687583; }
        .c141-payment-notice th { text-align: left; background: #f2f5f7; }
        .c141-payment-notice .amount { text-align: right; white-space: nowrap; }
        .c141-notice-totals { margin-top: 14px; }
        .c141-notice-totals td { text-align: right; min-width: 100px; }
        .c141-notice-balance { font-size: 16px; font-weight: 700; }
        .c141-notice-notes { margin-top: 12px; font-size: 13px; }
        .c141-notice-notes p { margin: 4px 0; }
        @@media print {
            body { background: #fff; }
            .no-print, .c141-preview-results { display: none !important; }
            .c141-payment-notice { max-width: none; margin: 0; padding: 8mm; border: 0; }
            .c141-payment-notice:last-child { break-after: auto; }
            @@page { size: A4 portrait; margin: 10mm; }
        }
        @@media screen and (max-width: 700px) {
            .c141-notice-patient { grid-template-columns: repeat(2, 1fr); }
            .c141-payment-notice { margin: 10px; padding: 18px; overflow-x: auto; }
        }
    </style>
</head>
<body>
    <header class="no-print">
        <span>C141 通知單處理結果</span>
        <button type="button" onclick="window.print()">列印已產生通知單</button>
    </header>
    <main class="c141-preview-results">
        @foreach (var item in Model.Items)
        {
            <div class="c141-preview-result">
                <strong>@item.Status</strong>
                <span>@item.Key.AdmissionDate / @item.Key.AdmissionRoom / @item.Key.AdmissionNumber.ToString(CultureInfo.InvariantCulture)</span>
                <span>— @item.Message</span>
            </div>
        }
    </main>
    @foreach (var item in Model.Items.Where(item => item.Html is not null))
    {
        @Html.Raw(item.Html)
    }
</body>
</html>
