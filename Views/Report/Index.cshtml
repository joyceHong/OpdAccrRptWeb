@model OpdAccrRptWeb.ViewModels.ReportIndexViewModel
@inject OpdAccrRptWeb.Services.IUserDisplayNameService UserDisplayNameService
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = "門急診報表作業";
    string initialState = JsonSerializer.Serialize(Model, new JsonSerializerOptions(JsonSerializerDefaults.Web));
    string? displayName = User.FindFirst("display_name")?.Value;
    string? givenName = User.FindFirst(ClaimTypes.GivenName)?.Value;
    string? profileName = User.Identity?.IsAuthenticated == true
        ? await UserDisplayNameService.GetDisplayNameAsync(User.Identity.Name, Context.RequestAborted)
        : null;
    string userName = !string.IsNullOrWhiteSpace(profileName) ? profileName
        : !string.IsNullOrWhiteSpace(displayName) ? displayName
        : !string.IsNullOrWhiteSpace(givenName) ? givenName
        : !string.IsNullOrWhiteSpace(User.Identity?.Name) ? User.Identity.Name!
        : "登入者";
}

<link rel="stylesheet" href="~/css/report-permissions.css" asp-append-version="true" />

<div id="report-app" v-cloak>
    @Html.AntiForgeryToken()
    <header class="app-header">
        <button class="brand" type="button" v-on:click="toggleMobileDrawer" :aria-expanded="mobileDrawerOpen" aria-controls="report-sidebar" aria-label="開啟報表選單">
            <span class="brand-mark">醫</span>
            <span><strong>門急診報表作業</strong><small>Outpatient Report Center</small></span>
        </button>
        <nav class="top-nav" aria-label="主要功能">
            <button v-for="category in state.categories" :key="category.key" type="button"
                    :class="{ active: !showPermissionSettings && activeCategory.key === category.key }" v-on:click="selectCategory(category)">
                {{ category.name }}
            </button>
            <button v-if="canManagePermissions" type="button" :class="{ active: showPermissionSettings }" v-on:click="openPermissionSettings">設定權限</button>
        </nav>
        <div class="user-menu">
            <button class="user-badge" type="button" aria-label="使用者選單：@userName" aria-haspopup="true">
                <span aria-hidden="true">@userName[..1]</span>
                <strong>@userName</strong>
                <span class="user-menu-chevron" aria-hidden="true">⌄</span>
            </button>
            <div class="user-menu-dropdown">
                <a href="/Account/logout">登出</a>
            </div>
        </div>
    </header>

    <div class="app-shell" :class="{ 'sidebar-pinned': sidebarPinned, 'sidebar-collapsed': !sidebarPinned }">
        <button v-if="!sidebarPinned" ref="sidebarTrigger" class="sidebar-slide-trigger" type="button"
                v-on:click="togglePinnedSidebar" aria-label="展開報表選單" :aria-expanded="sidebarPinned" aria-controls="report-sidebar">&gt;&gt;</button>
        <button v-if="mobileDrawerOpen" class="sidebar-backdrop" type="button" v-on:click="closeMobileDrawer" aria-label="關閉報表選單"></button>
        <aside id="report-sidebar" ref="sidebar" class="sidebar" :class="sidebarClasses"
               v-on:keydown.esc.stop="closeSidebarOverlay">
            <div id="sidebar-panel" class="sidebar-panel">
            <div class="sidebar-heading"><span>報表清單</span><span><button type="button" v-on:click="collapseAll">全部收合</button><button class="sidebar-close" type="button" v-on:click="togglePinnedSidebar" aria-label="收合報表選單" :aria-expanded="sidebarPinned" aria-controls="report-sidebar">&lt;&lt;</button></span></div>
            <label class="report-filter"><span>⌕</span><input v-model.trim="reportKeyword" placeholder="搜尋報表名稱或代碼" /></label>
            <div v-for="group in filteredGroups" :key="group.name" class="tree-group">
                <button class="tree-parent" type="button" :title="group.name" v-on:click="toggleGroup(group.name)" :aria-expanded="openGroups.includes(group.name)">
                    <span class="tree-group-name">{{ group.name }}</span><span :class="['chevron', { open: openGroups.includes(group.name) }]">⌄</span>
                </button>
                <div v-show="openGroups.includes(group.name)" class="tree-children">
                    <button v-for="report in group.reports" :key="report.code" type="button" :title="`${report.code} ${report.name}`"
                            :class="{ active: selectedReport && selectedReport.code === report.code }"
                            v-on:click="selectReport(report)">
                        <span class="report-code">{{ report.code }}</span><span class="report-name">{{ report.name }}</span>
                    </button>
                </div>
            </div>
            </div>
        </aside>

        <main class="content">
            <div class="content-inner">
            <div v-show="!showPermissionSettings">
            <section v-if="state.categories.length === 0" class="panel empty-result">
                <strong>尚未取得報表權限</strong>
            </section>
            <div class="breadcrumb">{{ activeCategory.name }} <span>›</span> {{ selectedReport ? selectedReport.name : '請選擇報表' }}</div>
            <router-view v-slot="{ Component }">
                <div v-if="Component && selectedReport" :key="selectedReport.code" class="report-content" v-report-query-collapse="selectedReport.code">
                <component
                    :is="Component"
                    :selected-report="selectedReport"
                    :default-start-date="state.defaultStartDate"
                    :default-end-date="state.defaultEndDate"
                    v-on:show-toast="showToast">
                </component>
                </div>
            </router-view>
            </div>
            <div v-show="showPermissionSettings" class="permission-container" aria-label="設定權限">
                <p v-if="permissionPanelLoading" role="status">載入權限設定中…</p>
                <p v-if="permissionPanelError" role="alert">{{ permissionPanelError }}</p>
                <div v-html="permissionPanelHtml"></div>
            </div>
            </div>
        </main>
    </div>
    <div v-if="toast" class="toast">{{ toast }}</div>
</div>

<script id="report-initial-state" type="application/json">@Html.Raw(initialState)</script>

@section Scripts {
    <script src="~/vendor/vue-router.global.prod.js"></script>
    <script src="~/js/components/report-autocomplete.js" asp-append-version="true"></script>
    <script src="~/js/components/report-date-range.js" asp-append-version="true"></script>
    @await Html.PartialAsync("~/Views/Report/_TemplateReport.cshtml")
    @await Html.PartialAsync("~/Views/Report/_C11ReceivablesCollectionReport.cshtml")
    @await Html.PartialAsync("~/Views/Report/_C12MedicalReceiptSummary.cshtml")
    @await Html.PartialAsync("~/Views/Report/_C5ChargeQuantityReport.cshtml")
    @await Html.PartialAsync("~/Views/Report/_C7DailyChargeDetailReport.cshtml")
    @await Html.PartialAsync("~/Views/Report/_C8PatchBillDetailReport.cshtml")
    @await Html.PartialAsync("~/Views/Report/_C9MaterialAccountingMonthlyReport.cshtml")
    @await Html.PartialAsync("~/Views/Report/_M1DoctorDailyReport.cshtml")
    @await Html.PartialAsync("~/Views/Report/_M2DoctorMonthlyReport.cshtml")
    @await Html.PartialAsync("~/Views/Report/_M3OpdEmergencyDailyReport.cshtml")
    @await Html.PartialAsync("~/Views/Report/_OpdPriceQuery.cshtml")
    @await Html.PartialAsync("~/Views/Report/_MedicalRecordQuery.cshtml")
    @await Html.PartialAsync("~/Views/Report/_RegistrationQuery.cshtml")
    @await Html.PartialAsync("~/Views/Report/_SapInterface.cshtml")
    <script src="~/js/reports/opd-price-query.js" asp-append-version="true"></script>
    <script src="~/js/reports/medical-record-query.js" asp-append-version="true"></script>
    <script src="~/js/reports/registration-query.js" asp-append-version="true"></script>
    <script src="~/js/reports/sap-interface.js" asp-append-version="true"></script>
    <script src="~/js/report-permissions.js" asp-append-version="true"></script>
    <script src="~/js/report-app.js" asp-append-version="true"></script>
}
