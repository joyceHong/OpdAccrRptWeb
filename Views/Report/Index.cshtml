@model OpdAccrRptWeb.ViewModels.ReportIndexViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "門急診報表作業";
    string initialState = JsonSerializer.Serialize(Model, new JsonSerializerOptions(JsonSerializerDefaults.Web));
}

<div id="report-app" v-cloak>
    @Html.AntiForgeryToken()
    <header class="app-header">
        <button class="brand" type="button" v-on:click="toggleMobileDrawer" :aria-expanded="mobileDrawerOpen" aria-controls="report-sidebar" aria-label="開啟報表選單">
            <span class="brand-mark">醫</span>
            <span><strong>門急診報表作業</strong><small>Outpatient Report Center</small></span>
        </button>
        <nav class="top-nav" aria-label="主要功能">
            <button v-for="category in state.categories" :key="category.key" type="button"
                    :class="{ active: activeCategory.key === category.key }" v-on:click="selectCategory(category)">
                {{ category.name }}
            </button>
        </nav>
        <div class="user-badge"><span>測</span><div>測試使用者<small>報表查詢人員</small></div></div>
    </header>

    <div class="app-shell" :class="{ 'sidebar-pinned': sidebarPinned, 'sidebar-collapsed': !sidebarPinned }">
        <button v-if="!sidebarPinned" ref="sidebarTrigger" class="sidebar-slide-trigger" type="button"
                v-on:click="togglePinnedSidebar" aria-label="展開報表選單" :aria-expanded="sidebarPinned" aria-controls="report-sidebar">&gt;&gt;</button>
        <button v-if="mobileDrawerOpen" class="sidebar-backdrop" type="button" v-on:click="closeMobileDrawer" aria-label="關閉報表選單"></button>
        <aside id="report-sidebar" ref="sidebar" class="sidebar" :class="sidebarClasses"
               v-on:keydown.esc.stop="closeSidebarOverlay">
            <div id="sidebar-panel" class="sidebar-panel">
            <div class="sidebar-heading"><span>報表清單</span><span><button type="button" v-on:click="collapseAll">全部收合</button><button class="sidebar-close" type="button" v-on:click="togglePinnedSidebar" aria-label="收合報表選單" :aria-expanded="sidebarPinned" aria-controls="report-sidebar">&lt;&lt;</button></span></div>
            <label class="report-filter"><span>⌕</span><input v-model.trim="reportKeyword" placeholder="搜尋報表名稱或代碼" /></label>
            <div v-for="(group, groupIndex) in filteredGroups" :key="group.name" class="tree-group">
                <button class="tree-parent" type="button" v-on:click="toggleGroup(groupIndex)">
                    <span>{{ group.name }}</span><span :class="['chevron', { open: openGroups.includes(groupIndex) }]">⌄</span>
                </button>
                <div v-show="openGroups.includes(groupIndex)" class="tree-children">
                    <button v-for="report in group.reports" :key="report.code" type="button"
                            :class="{ active: selectedReport && selectedReport.code === report.code }"
                            v-on:click="selectReport(report)">
                        <span class="report-code">{{ report.code }}</span><span>{{ report.name }}</span>
                    </button>
                </div>
            </div>
            </div>
        </aside>

        <main class="content">
            <div class="breadcrumb">{{ activeCategory.name }} <span>›</span> {{ selectedReport ? selectedReport.name : '請選擇報表' }}</div>
            <router-view v-slot="{ Component }">
                <component
                    v-if="Component && selectedReport"
                    :key="selectedReport.code"
                    :is="Component"
                    :selected-report="selectedReport"
                    :default-start-date="state.defaultStartDate"
                    :default-end-date="state.defaultEndDate"
                    :c21-rebuild-enabled="state.c21RebuildEnabled"
                    :c23-rebuild-enabled="state.c23RebuildEnabled"
                    v-on:show-toast="showToast">
                </component>
            </router-view>
        </main>
    </div>
    <div v-if="toast" class="toast">{{ toast }}</div>
</div>

<script id="report-initial-state" type="application/json">@Html.Raw(initialState)</script>

@section Scripts {
    <script src="~/vendor/vue-router.global.prod.js"></script>
    <script src="~/js/components/report-autocomplete.js" asp-append-version="true"></script>
    @await Html.PartialAsync("~/Views/Report/_TemplateReport.cshtml")
    @await Html.PartialAsync("~/Views/Report/_C11ReceivablesCollectionReport.cshtml")
    @await Html.PartialAsync("~/Views/Report/_C12MedicalReceiptSummary.cshtml")
    @await Html.PartialAsync("~/Views/Report/_C5ChargeQuantityReport.cshtml")
    @await Html.PartialAsync("~/Views/Report/_C7DailyChargeDetailReport.cshtml")
    @await Html.PartialAsync("~/Views/Report/_C8PatchBillDetailReport.cshtml")
    @await Html.PartialAsync("~/Views/Report/_C9MaterialAccountingMonthlyReport.cshtml")
    @await Html.PartialAsync("~/Views/Report/_M1DoctorDailyReport.cshtml")
    @await Html.PartialAsync("~/Views/Report/_M2DoctorMonthlyReport.cshtml")
    @await Html.PartialAsync("~/Views/Report/_M3OpdEmergencyDailyReport.cshtml")
    @await Html.PartialAsync("~/Views/Report/_OpdPriceQuery.cshtml")
    <script src="~/js/reports/opd-price-query.js" asp-append-version="true"></script>
    <script src="~/js/report-app.js" asp-append-version="true"></script>
}
