<template id="c12-report-template"><div>
<section class="page-title"><div><span class="eyebrow">C12</span><h1>{{selectedReport.name}}</h1><p>查詢病患期間內醫療費用，並預覽明細與彙總證明。</p></div><div class="no-print"><button class="outline-button" :disabled="!report?.hasVisits" @@click="openPreview('detail')">明細預覽／列印</button><button class="outline-button" :disabled="!report?.hasVisits" @@click="openPreview('summary')">彙總預覽／列印</button></div></section>
<section class="panel query-panel"><div><div class="panel-title"><span>查詢條件</span><small><i>*</i> 為必填欄位</small></div><form @@submit.prevent="search"><div class="date-row"><label><span>起始日期 <i>*</i></span><input v-model="form.startDate" type="date" required></label><span class="date-arrow">→</span><label><span>截止日期 <i>*</i></span><input v-model="form.endDate" type="date" required></label></div><fieldset class="source-fieldset"><legend>資料來源 <i>*</i></legend><label class="source-option"><input v-model="form.source" type="radio" name="c12Source" value="OpdEr"><span>門急診</span></label><label class="source-option"><input v-model="form.source" type="radio" name="c12Source" value="Inpatient"><span>住院</span></label></fieldset><div class="advanced-grid c12-query-grid"><label><span>門急診別</span><select v-model="form.roomScope" :disabled="form.source==='Inpatient'"><option value="All">全部</option><option value="Emergency">急診</option><option value="Outpatient">門診</option></select></label><label><span>新科別碼</span><div ref="sectionAutocomplete" class="report-autocomplete"><input v-model.trim="form.newSection" autocomplete="off" role="combobox" aria-autocomplete="list" aria-controls="c12-section-options" :aria-expanded="sectionOpen?'true':'false'" :aria-activedescendant="sectionActiveIndex>=0?`c12-section-option-${sectionActiveIndex}`:undefined" @@focus="openSectionOptions" @@input="openSectionOptions" @@keydown="onSectionKeydown"><div v-if="sectionOpen && filteredSectionOptions.length" id="c12-section-options" class="report-autocomplete-panel" role="listbox"><button v-for="(option,index) in filteredSectionOptions" :id="`c12-section-option-${index}`" :key="`${option.code}-${option.name}`" type="button" class="report-autocomplete-option" :class="{active:index===sectionActiveIndex}" role="option" :aria-selected="index===sectionActiveIndex?'true':'false'" @@mouseenter="sectionActiveIndex=index" @@mousedown.prevent="selectSectionOption(option)"><strong>{{option.code}}</strong><span>{{option.name}}</span></button></div></div></label><label><span>病歷號 <i>*</i></span><input v-model.trim="form.identity" maxlength="10" required></label></div><p v-if="sectionError" class="validation-message">{{sectionError}}</p><p v-if="error" class="validation-message">{{error}}</p><div class="form-actions"><button class="ghost-button" type="button" :disabled="loading" @@click="reset">重設</button><button class="primary-button" :disabled="loading">{{loading?'查詢中…':'⌕ 查詢'}}</button></div></form></div></section>
<section class="panel result-panel" :aria-busy="loading?'true':'false'"><div class="result-heading"><div><strong>查詢結果</strong><span v-if="!loading && detailRows.length">共 {{detailRows.length}} 筆</span></div><label v-if="!loading && detailRows.length">每頁顯示<select v-model.number="pageSize" @@change="currentPage=1"><option :value="10">10 筆</option><option :value="30">30 筆</option><option :value="50">50 筆</option></select></label></div><template v-if="loading"><span class="visually-hidden" role="status">資料查詢中</span><partial name="_TableSkeleton" /></template><div v-else-if="!detailRows.length" class="empty-result"><div>▤</div><strong>{{searched?'查無資料':'尚無查詢結果'}}</strong><p>{{searched?'目前條件沒有符合的明細資料。':'請設定查詢條件後按下「查詢」。'}}</p></div><template v-else><div v-for="warning in report.warnings" class="validation-message c12-warning">{{warning}}</div><div class="table-wrap"><table><thead><tr><th>日期</th><th>時段</th><th>診間</th><th>序號</th><th>科別</th><th>醫師</th><th>科目</th><th>健保</th><th>自付</th><th>優待／記帳</th><th>實收</th></tr></thead><tbody><tr v-for="row in pagedRows" :key="`${row.visitDate}-${row.visitTime}-${row.room}-${row.visitNumber}-${row.sequence}`"><td>{{displayRoc(row.visitDate)}}</td><td>{{row.visitTime}}</td><td>{{row.room}}</td><td>{{row.visitNumber}}</td><td>{{row.sectionName}}</td><td>{{row.doctorName}}</td><td>{{row.itemName}}</td><td>{{number(row.insuranceAmount)}}</td><td>{{number(row.rawSelfPayAmount)}}</td><td>{{number(row.discountOrOnAccountAmount)}}</td><td>{{number(row.receivedAmount)}}</td></tr></tbody></table></div></template><div v-if="detailRows.length" class="pagination"><span>第 {{currentPage}} / {{totalPages}} 頁</span><div><button type="button" aria-label="第一頁" :disabled="loading||currentPage===1" @@click="currentPage=1">‹‹</button><button type="button" :disabled="loading||currentPage===1" @@click="currentPage--">‹</button><button class="active" type="button">{{currentPage}}</button><button type="button" :disabled="loading||currentPage===totalPages" @@click="currentPage++">›</button><button type="button" aria-label="最後一頁" :disabled="loading||currentPage===totalPages" @@click="currentPage=totalPages">››</button></div></div></section>
<div v-if="preview" class="c12-preview-overlay" role="dialog" aria-modal="true"><div class="c12-preview-actions no-print"><button class="ghost-button" @@click="preview=null">關閉預覽</button><button class="primary-button" @@click="printReport">列印</button></div><article class="c12-paper" :class="{'c12-detail-paper':preview==='detail'}">
<template v-if="preview==='detail'"><header class="c12-detail-header c12-document-header"><h1>亞東紀念醫院</h1><h2>醫療費用收據彙總證明</h2><h3>【費用明細】</h3></header><div class="c12-detail-meta c12-print-meta"><div class="c12-meta-left"><p>列印日期：{{printDate}}</p><p>病歷號：{{report.patient.medicalRecordNumber}}</p><p>資料起日：{{displayRoc(report.criteria.startDate)}}</p></div><div class="c12-meta-center"><p>姓名：{{report.patient.name}}</p><p>資料迄日：{{displayRoc(report.criteria.endDate)}}</p></div><div class="c12-meta-right"><p>頁數：<span class="c12-page-number"><span class="c12-page-fallback">1 / 1</span></span></p><p>身分證字號：{{report.patient.nationalId}}</p><p>診別：{{report.criteria.roomTypeLabel}}</p></div></div><section v-for="visit in report.detailVisits" class="c12-visit"><div class="c12-visit-meta"><span>日期：{{displayRoc(visit.visit.key.date)}}</span><span>科別：{{visit.visit.sectionName}}</span><span>主治醫師：{{visit.visit.doctorName}}</span></div><table class="c12-detail-table"><thead><tr><th>項目</th><th>健保</th><th>自付</th><th>項目</th><th>健保</th><th>自付</th><th>項目</th><th>健保</th><th>自付</th></tr></thead><tbody><tr v-for="row in visit.rows"><template v-for="item in [row.item1,row.item2,row.item3]"><td>{{item?.name||''}}</td><td>{{item?number(item.insuranceAmount):''}}</td><td>{{item?number(item.rawSelfPayAmount):''}}</td></template></tr></tbody><tfoot><tr><th>總醫療費：</th><td>{{number(visit.total)}}</td><th>健保申請：</th><td>{{number(visit.insuranceTotal)}}</td><th colspan="2">優待／記帳金額：</th><td>{{number(visit.discountTotal)}}</td><th>實收金額：</th><td>{{number(visit.receivedTotal)}}</td></tr></tfoot></table></section></template>
<template v-else><div class="c12-summary-paper"><header class="c12-document-header"><h1>亞東紀念醫院</h1><h2>醫療費用收據彙總證明</h2><h3>【費用彙總】</h3></header><div class="c12-print-meta"><div class="c12-meta-left"><p>列印日期：{{printDate}}</p><p>病歷號：{{report.patient.medicalRecordNumber}}</p><p>資料起日：{{displayRoc(report.criteria.startDate)}}</p></div><div class="c12-meta-center"><p>姓名：{{report.patient.name}}</p><p>資料迄日：{{displayRoc(report.criteria.endDate)}}</p></div><div class="c12-meta-right"><p>頁數：<span class="c12-page-number"><span class="c12-page-fallback">1 / 1</span></span></p><p>身分證字號：{{report.patient.nationalId}}</p><p>診別：{{report.criteria.roomTypeLabel}}</p></div></div><table class="c12-summary-table"><thead><tr><th>項目名稱</th><th>健保費用</th><th>自付費用</th></tr></thead><tbody><tr v-for="row in report.summaryRows"><td>{{row.name}}</td><td>{{number(row.insuranceAmount)}}</td><td>{{number(row.rawSelfPayAmount)}}</td></tr></tbody></table><section class="c12-summary-totals"><h4>【合計】</h4><dl><dt>總醫療費：</dt><dd>{{number(report.summaryTotals.total)}}</dd><dt>健保申請：</dt><dd>{{number(report.summaryTotals.insurance)}}</dd><dt>優待／記帳金額：</dt><dd>{{number(report.summaryTotals.discountOrOnAccount)}}</dd><dt>實收金額：</dt><dd>{{number(report.summaryTotals.received)}}</dd></dl></section><footer class="c12-summary-footer"><strong>※請妥善保存，以免個人資料外洩！</strong><span>頁數：<span class="c12-page-number"><span class="c12-page-fallback">1 / 1</span></span></span></footer></div></template></article></div>
</div></template>
<script>window.ReportComponents=window.ReportComponents||{};window.ReportComponents.C12Report={template:"#c12-report-template",props:["selectedReport","defaultStartDate","defaultEndDate"],data(){return{form:{startDate:"",endDate:"",source:"OpdEr",roomScope:"All",newSection:"",identity:""},sectionOptions:[],sectionError:"",sectionOpen:false,sectionActiveIndex:-1,report:null,loading:false,error:"",searched:false,preview:null,pageSize:10,currentPage:1,printDate:""}},computed:{filteredSectionOptions(){const q=this.form.newSection.trim().toUpperCase();return this.sectionOptions.filter(option=>!q||option.code.toUpperCase().includes(q)||option.name.toUpperCase().includes(q))},detailRows(){return this.report?.detailRows||[]},totalPages(){return Math.max(1,Math.ceil(this.detailRows.length/this.pageSize))},pagedRows(){const start=(this.currentPage-1)*this.pageSize;return this.detailRows.slice(start,start+this.pageSize)}},mounted(){this.reset();this.loadSectionOptions();document.addEventListener("pointerdown",this.closeSectionOptionsFromOutside)},beforeUnmount(){document.removeEventListener("pointerdown",this.closeSectionOptionsFromOutside)},watch:{"form.source"(v){if(v==="Inpatient")this.form.roomScope="All"}},methods:{reset(){this.form={startDate:this.defaultStartDate||"",endDate:this.defaultEndDate||"",source:"OpdEr",roomScope:"All",newSection:"",identity:""};this.sectionOpen=false;this.sectionActiveIndex=-1;this.report=null;this.error="";this.searched=false;this.preview=null;this.currentPage=1;this.printDate=""},openSectionOptions(){this.sectionOpen=true;this.sectionActiveIndex=-1},selectSectionOption(option){this.form.newSection=option.code;this.sectionOpen=false;this.sectionActiveIndex=-1},onSectionKeydown(event){const count=this.filteredSectionOptions.length;if(event.key==="Escape"){this.sectionOpen=false;this.sectionActiveIndex=-1;return}if(!count)return;if(event.key==="ArrowDown"){event.preventDefault();this.sectionOpen=true;this.sectionActiveIndex=(this.sectionActiveIndex+1)%count}else if(event.key==="ArrowUp"){event.preventDefault();this.sectionOpen=true;this.sectionActiveIndex=(this.sectionActiveIndex-1+count)%count}else if(event.key==="Enter"&&this.sectionOpen&&this.sectionActiveIndex>=0){event.preventDefault();this.selectSectionOption(this.filteredSectionOptions[this.sectionActiveIndex])}},closeSectionOptionsFromOutside(event){if(!this.$refs.sectionAutocomplete?.contains(event.target)){this.sectionOpen=false;this.sectionActiveIndex=-1}},async loadSectionOptions(){this.sectionError="";try{const r=await fetch("/Report/GetC12SectionOptions");const p=await r.json();if(!r.ok)throw new Error();this.sectionOptions=Array.isArray(p)?p:[]}catch{this.sectionOptions=[];this.sectionError="無法載入科別清單，仍可直接輸入科別代碼。"}},async search(){this.loading=true;this.error="";this.report=null;this.preview=null;this.sectionOpen=false;try{const r=await fetch("/Report/GetReportData",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({reportCode:"C12",startDate:this.form.startDate,endDate:this.form.endDate,source:this.form.source,roomScope:this.form.roomScope,medicalRecordNo:this.form.identity,newSectionCode:this.form.newSection||undefined})});const p=await r.json();this.searched=true;if(!r.ok)throw new Error(p.title||p||"查詢失敗");this.report=p;this.currentPage=1}catch(e){this.error=e.message||"查詢失敗"}finally{this.loading=false}},openPreview(type){if(this.report){this.printDate=this.formatTaipeiDate(new Date());this.preview=type}},printReport(){window.print()},formatTaipeiDate(value){const parts=new Intl.DateTimeFormat("en-CA",{timeZone:"Asia/Taipei",year:"numeric",month:"2-digit",day:"2-digit"}).formatToParts(value);const part=type=>parts.find(item=>item.type===type)?.value||"";return `${part("year")}/${part("month")}/${part("day")}`},number(v){return new Intl.NumberFormat("zh-TW",{maximumFractionDigits:0}).format(v||0)},displayRoc(v){return v&&v.length>=7?`${v.slice(0,3)}/${v.slice(3,5)}/${v.slice(5,7)}`:v}}};</script>
