@model OpdAccrRptWeb.ViewModels.C13PreviewViewModel
@{
    const int rowsPerPage = 32;
    var pages = Model.Rows.Chunk(rowsPerPage).ToList();
}
@for (int pageIndex = 0; pageIndex < pages.Count; pageIndex++)
{
    <section class="c13-print-document">
        <header class="c13-print-header">
            <div class="c13-print-heading">
                <h1>亞東紀念醫院報表作業</h1>
                <h2>社會服務需求急診高危險群個案明細表</h2>
            </div>
            <div class="c13-print-meta">
                <span>處理日期：@Model.GeneratedAt</span>
                <span>資料日期：@Model.StartDate　/　@Model.EndDate</span>
                <span>頁次：@(pageIndex + 1) / @pages.Count</span>
            </div>
        </header>
        <table class="c13-print-table">
            <colgroup>
                <col class="c13-visit-date" /><col class="c13-record-number" />
                <col class="c13-patient-name" /><col class="c13-identity" />
                <col class="c13-payment" /><col class="c13-birth-date" />
                <col class="c13-national-id" /><col class="c13-address" />
                <col class="c13-telephone" /><col class="c13-bed-number" />
            </colgroup>
            <thead><tr><th>就診日</th><th>病歷號</th><th>病患姓名</th><th>就診身份</th><th>部份負擔</th><th>生日</th><th>身分證字號</th><th>住址</th><th>電話</th><th>急診床號</th></tr></thead>
            <tbody>
                @foreach (var row in pages[pageIndex])
                {
                    <tr><td>@row.VisitDate</td><td>@row.MedicalRecordNumber</td><td>@row.PatientName</td><td>@row.IdentityName</td><td>@row.PartialPaymentName</td><td>@row.BirthDate</td><td>@row.NationalId</td><td>@row.Address</td><td>@row.Telephone</td><td>@row.EmergencyBedNumber</td></tr>
                }
            </tbody>
        </table>
    </section>
}
