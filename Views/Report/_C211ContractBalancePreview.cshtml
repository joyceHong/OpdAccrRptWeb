@model OpdAccrRptWeb.ViewModels.C211ContractBalancePreviewViewModel
@{
    var rowsByContract = Model.Rows
        .GroupBy(row => row.ContractCode, StringComparer.Ordinal)
        .ToDictionary(group => group.Key, group => group.ToList(), StringComparer.Ordinal);
}

<article class="c211-print-document">
    <header class="c211-print-header">
        <h1>@Model.Summary.Title</h1>
        <p>@Model.Summary.ReportDate</p>
        <div class="c211-print-meta">
            <span>程式編號：@Model.Summary.ProgramNo</span>
            <span>報表編號：@Model.Summary.ReportNo</span>
            <span>處理時間：@Model.Summary.ProcessDateTime</span>
            <span>製表人：@Model.Summary.EditUser</span>
        </div>
    </header>

    @foreach (var group in Model.Summary.Groups)
    {
        <section class="c211-print-group">
            <h2>合約身分：@group.ContractCode</h2>
            <table class="c211-print-table">
                <thead>
                    <tr>
                        <th>病歷號</th>
                        <th>就診日期</th>
                        <th class="amount">一般身分合約金額</th>
                        <th class="amount">健保身分合約金額</th>
                    </tr>
                </thead>
                <tbody>
                    @if (rowsByContract.TryGetValue(group.ContractCode, out var groupRows))
                    {
                        @foreach (var row in groupRows)
                        {
                            <tr>
                                <td>@row.MedicalRecordNo</td>
                                <td>@row.VisitDate</td>
                                <td class="amount">@row.SelfAmount</td>
                                <td class="amount">@row.ClaimAmount</td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="2">合約小計</th>
                        <th class="amount">@group.SelfAmount</th>
                        <th class="amount">@group.ClaimAmount</th>
                    </tr>
                </tfoot>
            </table>
        </section>
    }

    <footer class="c211-print-grand-total">
        <strong>報表總計</strong>
        <span>一般身分合約金額：@Model.Summary.SelfGrandTotal</span>
        <span>健保身分合約金額：@Model.Summary.ClaimGrandTotal</span>
    </footer>
</article>
