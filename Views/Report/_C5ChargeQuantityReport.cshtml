<template id="c5-report-template"><div>
<section class="page-title"><div><span class="eyebrow">{{ selectedReport.code }}</span><h1>{{ selectedReport.name }}</h1><p>設定查詢區間與條件，送出後即可檢視報表資料。</p></div><button class="outline-button no-print" type="button" :disabled="!previewAvailable || isLoading || previewLoading" v-show="selectedReport.canPrint" v-on:click="openPreview">{{ previewLoading ? '載入預覽…' : '預覽／列印' }}</button></section>
<section class="panel query-panel" :class="{ 'c6-report': selectedReport.code === 'C6' }"><div><div class="panel-title"><span>查詢條件</span><small><i>*</i> 為必填欄位</small></div><form v-on:submit.prevent="search">
<div class="date-row"><label><span>起始日期 <i>*</i></span><input v-model="form.startDate" type="date" required v-on:change="syncDefaultEndDate" /></label><span class="date-arrow">→</span><label><span>截止日期 <i>*</i></span><input v-model="form.endDate" type="date" required v-on:change="markEndDateChanged" /></label></div>
<fieldset class="source-fieldset segmented-source-fieldset"><legend>就醫來源 <i>*</i></legend><label class="source-option"><input v-model.number="form.dataSource" type="radio" name="c5Source" :value="0" v-on:change="changeSource" /><span>門急診</span></label><label class="source-option"><input v-model.number="form.dataSource" type="radio" name="c5Source" :value="1" v-on:change="changeSource" /><span>住院</span></label></fieldset>
<fieldset class="source-fieldset" :class="{ 'segmented-source-fieldset': selectedReport.code === 'C5' }"><legend>報表內容 <i>*</i></legend><label v-for="item in [{v:0,n:'彙總'},{v:1,n:'每日'},{v:2,n:'病患明細'}]" :key="item.v" class="source-option"><input v-model.number="form.detailType" type="radio" name="c5Detail" :value="item.v" /><span>{{ item.n }}</span></label></fieldset>
<fieldset class="source-fieldset" :class="{ 'segmented-source-fieldset': selectedReport.code === 'C5' }"><legend>計價類型 <i>*</i></legend><label class="source-option"><input v-model.number="form.chargeKind" type="radio" name="c5Charge" :value="0" /><span>藥品</span></label><label class="source-option"><input v-model.number="form.chargeKind" type="radio" name="c5Charge" :value="1" /><span>醫令</span></label></fieldset>
<button v-if="selectedReport.code === 'C5'" ref="filterButton" class="c22-filter-button" type="button" :aria-label="activeFilterCount ? `進階篩選，已套用 ${activeFilterCount} 項` : '進階篩選'" aria-haspopup="dialog" aria-controls="c5-filter-dialog" v-on:click="openFilters"><svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 17h16"/><circle cx="9" cy="7" r="2.5" fill="white"/><circle cx="16" cy="17" r="2.5" fill="white"/></svg><span>進階篩選</span><span v-if="activeFilterCount" class="c22-filter-count">{{ activeFilterCount }}</span></button>
<button v-else class="advanced-filter-toggle" type="button" :aria-expanded="advancedOpen?'true':'false'" aria-controls="c5-advanced-filters" v-on:click="advancedOpen=!advancedOpen">進階篩選 <span v-if="activeFilterCount" class="active-filter-count">已套用 {{ activeFilterCount }} 項</span><span class="chevron" :class="{open:advancedOpen}">⌄</span></button>
<transition name="advanced-filter"><div v-if="selectedReport.code === 'C6'" v-show="advancedOpen" id="c5-advanced-filters" class="advanced-grid advanced-filter-region open"><label><span>門急診別</span><select v-model.number="form.encounterType" :disabled="form.dataSource===1"><option :value="0">全部</option><option :value="1">急診</option><option :value="2">門診</option></select></label><label><span>科別</span><div class="report-autocomplete"><input v-model="form.organizationQuery" autocomplete="off" placeholder="輸入新碼或部門名稱" role="combobox" aria-autocomplete="list" aria-controls="c5-organization-options" :aria-expanded="organizations.length ? 'true' : 'false'" v-on:input="onOrganizationInput" /><div v-if="organizations.length" id="c5-organization-options" class="report-autocomplete-panel" role="listbox"><button v-for="item in organizations" :key="`${item.source}-${item.legacyCode}`" type="button" class="report-autocomplete-option" role="option" v-on:mousedown.prevent="selectOrganization(item)"><strong>{{ item.newCode }}</strong><span>|{{ item.displayName }}</span></button></div></div></label><label><span>診間</span><input v-model.trim="form.roomNo" :disabled="form.dataSource===1 || selectedReport.code==='C6'" /></label><label><span>批價碼</span><input v-model.trim="form.chargeCode" /></label><label><span>健保身份</span><select v-model="form.insuranceIdentityCode"><option value="">全部</option><option value="01">01 一般民眾</option><option value="030">030 健保</option><option value="035">035 健保未帶卡</option></select></label></div></transition>
<p v-if="validationMessage" class="validation-message">{{ validationMessage }}</p><div class="form-actions"><button class="ghost-button" type="button" :disabled="isLoading" v-on:click="resetForm">重設</button><button class="primary-button" type="submit" :disabled="isLoading">{{ isLoading ? '查詢中…' : '⌕ 查詢' }}</button></div></form></div></section>
<section class="panel result-panel" :aria-busy="isLoading ? 'true' : 'false'"><div class="result-heading"><div><strong>查詢結果</strong><span v-if="!isLoading && hasResults">共 {{ totalCount }} 筆</span></div><label v-if="!isLoading && hasResults">每頁顯示<select v-model.number="pageSize" v-on:change="changePageSize"><option :value="10">10 筆</option><option :value="30">30 筆</option><option :value="50">50 筆</option></select></label></div>
<template v-if="isLoading"><span class="visually-hidden" role="status">資料查詢中</span>@await Html.PartialAsync("_TableSkeleton")</template><div v-else-if="!hasResults" class="empty-result"><div>▤</div><strong>{{ hasSearched ? '查無資料' : '尚無查詢結果' }}</strong><p>{{ hasSearched ? '目前條件沒有符合的資料。' : '請設定上方查詢條件後按下「查詢」。' }}</p></div>
<template v-else><div class="table-wrap"><table><thead><tr><th v-for="c in columns" :key="c.key">{{ c.label }}</th></tr></thead><tbody><tr v-for="(row,i) in rows" :key="i"><td v-for="c in columns" :key="c.key">{{ row[c.key] }}</td></tr></tbody></table></div><div class="pagination"><span>第 {{ currentPage }} / {{ totalPages }} 頁</span><div><button type="button" aria-label="第一頁" :disabled="currentPage===1" v-on:click="goToPage(1)">‹‹</button><button type="button" :disabled="currentPage===1" v-on:click="goToPage(currentPage-1)">‹</button><button class="active" type="button">{{ currentPage }}</button><button type="button" :disabled="currentPage===totalPages" v-on:click="goToPage(currentPage+1)">›</button><button type="button" aria-label="最後一頁" :disabled="currentPage===totalPages" v-on:click="goToPage(totalPages)">››</button></div></div></template></section>
<div v-if="filterOpen" class="c22-filter-overlay no-print" role="presentation" v-on:click.self="closeFilters"><section id="c5-filter-dialog" class="c22-filter-dialog c5-filter-dialog" role="dialog" aria-modal="true" aria-labelledby="c5-filter-title" v-on:keydown.esc="closeFilters"><h2 id="c5-filter-title" ref="filterTitle" tabindex="-1">進階篩選條件</h2><div class="advanced-grid"><label><span>門急診別</span><select v-model.number="filterDraft.encounterType" :disabled="form.dataSource===1"><option :value="0">全部</option><option :value="1">急診</option><option :value="2">門診</option></select></label><label><span>科別</span><div class="report-autocomplete"><input v-model="filterDraft.organizationQuery" autocomplete="off" placeholder="輸入新碼或部門名稱" role="combobox" aria-autocomplete="list" aria-controls="c5-filter-organization-options" :aria-expanded="organizations.length ? 'true' : 'false'" v-on:input="onOrganizationInput" /><div v-if="organizations.length" id="c5-filter-organization-options" class="report-autocomplete-panel" role="listbox"><button v-for="item in organizations" :key="`${item.source}-${item.legacyCode}`" type="button" class="report-autocomplete-option" role="option" v-on:mousedown.prevent="selectOrganization(item)"><strong>{{ item.newCode }}</strong><span>|{{ item.displayName }}</span></button></div></div></label><label><span>診間</span><input v-model.trim="filterDraft.roomNo" :disabled="form.dataSource===1" /></label><label><span>批價碼</span><input v-model.trim="filterDraft.chargeCode" /></label><label><span>健保身份</span><select v-model="filterDraft.insuranceIdentityCode"><option value="">全部</option><option value="01">01 一般民眾</option><option value="030">030 健保</option><option value="035">035 健保未帶卡</option></select></label></div><div class="c22-filter-actions"><button class="ghost-button" type="button" v-on:click="closeFilters">取消</button><button class="primary-button" type="button" v-on:click="applyFilters">套用篩選</button></div></section></div>
<div v-if="previewOpen && preview" class="report-preview-overlay c5-preview-overlay" role="dialog" aria-modal="true" aria-label="C5 列印預覽"><div class="report-preview-actions no-print"><button class="ghost-button" type="button" v-on:click="closePreview">關閉預覽</button><button class="primary-button" type="button" v-on:click="printPreview">列印</button></div><article v-for="(page, pageIndex) in previewPages" :key="pageIndex" class="report-preview-paper c5-paper"><header class="c5-print-header"><h1>{{ preview.title }}</h1><div class="c5-print-meta"><div><template v-if="selectedReport.code === 'C6'"><span>報表名稱：{{ preview.reportName }}</span><span>程式名稱：{{ preview.detailType === 2 ? 'Module1' : 'C5' }}</span></template><span>處理日期：{{ preview.generatedAt }}</span></div><div class="c5-print-date">{{ page.source }}<br />批價日期：{{ formatPreviewDate(preview.startDate) }} ／ {{ formatPreviewDate(preview.endDate) }}</div><div class="c5-print-page">頁次：{{ pageIndex + 1 }} / {{ previewPages.length }}</div></div></header><table v-if="preview.detailType === 2" class="c5-print-table c5-detail-table"><thead><tr><th>科別</th><th>科別名稱</th><th>醫生代號</th><th>醫生姓名</th><th>日期</th><th>病歷號</th><th>病患姓名</th><th class="number">單價</th><th class="number">數量</th><th class="number">金額</th></tr></thead><tbody><template v-for="(line, lineIndex) in page.lines" :key="lineIndex"><tr v-if="line.type === 'section'" class="c5-detail-section"><td>{{ line.row.sectionCode }}</td><td colspan="9">{{ line.row.sectionName }}</td></tr><tr v-else-if="line.type === 'charge'" class="c5-detail-charge"><td></td><td>{{ line.row.chargeCode }}</td><td colspan="8">{{ line.row.chargeName }}</td></tr><tr v-else><td></td><td></td><td>{{ line.row.doctorId }}</td><td>{{ line.row.doctorName }}</td><td>{{ formatPreviewDate(line.row.serviceDate) }}</td><td>{{ line.row.medicalRecordNo }}</td><td>{{ line.row.patientName }}</td><td class="number">{{ formatPreviewNumber(line.row.unitPrice) }}</td><td class="number">{{ formatPreviewNumber(line.row.quantity, true) }}</td><td class="number">{{ formatPreviewNumber(line.row.amount) }}</td></tr></template></tbody></table><table v-else class="c5-print-table"><thead><tr><th>科別代號</th><th>科別名稱</th><th>批價碼</th><th>批價名稱</th><th v-if="preview.detailType !== 0">批價日期</th><th v-if="preview.detailType === 2">病歷號</th><th v-if="preview.detailType === 2">病患姓名</th><th v-if="preview.detailType === 2">醫師姓名</th><th class="number">單價</th><th class="number">數量</th><th class="number">金額</th></tr></thead><tbody><template v-for="(line, lineIndex) in page.lines" :key="lineIndex"><tr v-if="line.type === 'row'"><td>{{ line.row.sectionCode }}</td><td>{{ line.row.sectionName }}</td><td>{{ line.row.chargeCode }}</td><td>{{ line.row.chargeName }}</td><td v-if="preview.detailType !== 0">{{ formatPreviewDate(line.row.serviceDate) }}</td><td v-if="preview.detailType === 2">{{ line.row.medicalRecordNo }}</td><td v-if="preview.detailType === 2">{{ line.row.patientName }}</td><td v-if="preview.detailType === 2">{{ line.row.doctorName }}</td><td class="number">{{ formatPreviewNumber(line.row.unitPrice) }}</td><td class="number">{{ formatPreviewNumber(line.row.quantity, true) }}</td><td class="number">{{ formatPreviewNumber(line.row.amount) }}</td></tr><tr v-else class="c5-print-subtotal"><td :colspan="previewLeadingColumns">小計</td><td></td><td class="number">{{ formatPreviewNumber(line.quantity, true) }}</td><td class="number">{{ formatPreviewNumber(line.amount) }}</td></tr></template></tbody><tfoot v-if="page.isLastForSource"><tr><th :colspan="previewLeadingColumns">總計</th><td></td><td class="number">{{ formatPreviewNumber(page.totals.quantity, true) }}</td><td class="number">{{ formatPreviewNumber(page.totals.amount) }}</td></tr></tfoot></table><footer class="c5-print-footer">製表人：{{ preview.preparedBy }}</footer></article></div>
</div></template><script src="~/js/reports/c5-report.js" asp-append-version="true"></script>
