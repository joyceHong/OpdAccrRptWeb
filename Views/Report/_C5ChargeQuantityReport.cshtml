<template id="c5-report-template"><div>
<section class="page-title"><div><span class="eyebrow">{{ selectedReport.code }}</span><h1>{{ selectedReport.name }}</h1><p>設定查詢區間與條件，送出後即可檢視報表資料。</p></div><button class="outline-button no-print" type="button" :disabled="!hasResults || isLoading" v-on:click="openPreview">預覽／列印</button></section>
<section class="panel query-panel"><div><div class="panel-title"><span>查詢條件</span><small><i>*</i> 為必填欄位</small></div><form v-on:submit.prevent="search">
<div class="date-row"><label><span>起始日期 <i>*</i></span><input v-model="form.startDate" type="date" required /></label><span class="date-arrow">→</span><label><span>截止日期 <i>*</i></span><input v-model="form.endDate" type="date" required /></label></div>
<fieldset class="source-fieldset"><legend>就醫來源 <i>*</i></legend><label class="source-option"><input v-model.number="form.dataSource" type="radio" name="c5Source" :value="0" v-on:change="changeSource" /><span>門急診</span></label><label class="source-option"><input v-model.number="form.dataSource" type="radio" name="c5Source" :value="1" v-on:change="changeSource" /><span>住院</span></label></fieldset>
<fieldset class="source-fieldset"><legend>報表內容 <i>*</i></legend><label v-for="item in [{v:0,n:'彙總'},{v:1,n:'每日'},{v:2,n:'病患明細'}]" :key="item.v" class="source-option"><input v-model.number="form.detailType" type="radio" name="c5Detail" :value="item.v" /><span>{{ item.n }}</span></label></fieldset>
<fieldset class="source-fieldset"><legend>計價類型 <i>*</i></legend><label class="source-option"><input v-model.number="form.chargeKind" type="radio" name="c5Charge" :value="0" /><span>藥品</span></label><label class="source-option"><input v-model.number="form.chargeKind" type="radio" name="c5Charge" :value="1" /><span>醫令</span></label></fieldset>
<div class="advanced-grid"><label><span>門急診別</span><select v-model.number="form.encounterType" :disabled="form.dataSource===1"><option :value="0">全部</option><option :value="1">急診</option><option :value="2">門診</option></select></label><label><span>科別</span><div class="report-autocomplete"><input v-model="form.organizationQuery" autocomplete="off" placeholder="輸入新碼或部門名稱" role="combobox" aria-autocomplete="list" aria-controls="c5-organization-options" :aria-expanded="organizations.length ? 'true' : 'false'" v-on:input="onOrganizationInput" /><div v-if="organizations.length" id="c5-organization-options" class="report-autocomplete-panel" role="listbox"><button v-for="item in organizations" :key="`${item.source}-${item.legacyCode}`" type="button" class="report-autocomplete-option" role="option" v-on:mousedown.prevent="selectOrganization(item)"><strong>{{ item.newCode }}</strong><span>|{{ item.displayName }}</span></button></div></div></label><label><span>診間</span><input v-model.trim="form.roomNo" :disabled="form.dataSource===1 || selectedReport.code==='C6'" /></label><label><span>批價碼</span><input v-model.trim="form.chargeCode" /></label><label><span>健保身份</span><select v-model="form.insuranceIdentityCode"><option value="">全部</option><option value="01">01 一般民眾</option><option value="030">030 健保</option><option value="035">035 健保未帶卡</option></select></label></div>
<p v-if="validationMessage" class="validation-message">{{ validationMessage }}</p><div class="form-actions"><button class="ghost-button" type="button" :disabled="isLoading" v-on:click="resetForm">重設</button><button class="primary-button" type="submit" :disabled="isLoading">{{ isLoading ? '查詢中…' : '⌕ 查詢' }}</button></div></form></div></section>
<section class="panel result-panel" :aria-busy="isLoading ? 'true' : 'false'"><div class="result-heading"><div><strong>查詢結果</strong><span v-if="!isLoading && hasResults">共 {{ totalCount }} 筆</span></div><label v-if="!isLoading && hasResults">每頁顯示<select v-model.number="pageSize" v-on:change="changePageSize"><option :value="10">10 筆</option><option :value="30">30 筆</option><option :value="50">50 筆</option></select></label></div>
<template v-if="isLoading"><span class="visually-hidden" role="status">資料查詢中</span>@await Html.PartialAsync("_TableSkeleton")</template><div v-else-if="!hasResults" class="empty-result"><div>▤</div><strong>{{ hasSearched ? '查無資料' : '尚無查詢結果' }}</strong><p>{{ hasSearched ? '目前條件沒有符合的資料。' : '請設定上方查詢條件後按下「查詢」。' }}</p></div>
<template v-else><div class="table-wrap"><table><thead><tr><th v-for="c in columns" :key="c.key">{{ c.value }}</th></tr></thead><tbody><tr v-for="(row,i) in rows" :key="i"><td v-for="c in columns" :key="c.key">{{ row[c.key] }}</td></tr></tbody></table></div><div class="pagination"><span>第 {{ currentPage }} / {{ totalPages }} 頁</span><div><button type="button" aria-label="第一頁" :disabled="currentPage===1" v-on:click="goToPage(1)">‹‹</button><button type="button" :disabled="currentPage===1" v-on:click="goToPage(currentPage-1)">‹</button><button class="active" type="button">{{ currentPage }}</button><button type="button" :disabled="currentPage===totalPages" v-on:click="goToPage(currentPage+1)">›</button><button type="button" aria-label="最後一頁" :disabled="currentPage===totalPages" v-on:click="goToPage(totalPages)">››</button></div></div></template></section>
</div></template><script src="~/js/reports/c5-report.js" asp-append-version="true"></script>
