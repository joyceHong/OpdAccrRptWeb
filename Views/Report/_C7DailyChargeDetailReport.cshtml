<template id="c7-report-template"><div>
<section class="page-title"><div><span class="eyebrow">C7</span><h1>{{ selectedReport.name }}</h1><p>依日期、時間、輸入人員查詢門急診每日批價明細。</p></div><button class="outline-button no-print" type="button" :disabled="!hasResults || isLoading || previewLoading" v-on:click="openPreview">{{ previewLoading ? '載入預覽…' : '預覽／列印' }}</button></section>
<section class="panel query-panel"><div><div class="panel-title"><span>查詢條件</span><small><i>*</i> 為必填欄位</small></div><form v-on:submit.prevent="search"><div class="date-row"><label><span>起始日期 <i>*</i></span><input v-model="form.startDate" type="date" required v-on:change="conditionChanged" /></label><span class="date-arrow">→</span><label><span>截止日期 <i>*</i></span><input v-model="form.endDate" type="date" required v-on:change="endDateChanged" /></label></div>
<div class="advanced-grid"><label><span>起始時間 <i>*</i></span><input v-model="form.startTime" maxlength="4" pattern="[0-9]{4}" required v-on:input="conditionChanged" /></label><label><span>截止時間 <i>*</i></span><input v-model="form.endTime" maxlength="4" pattern="[0-9]{4}" required v-on:input="conditionChanged" /></label><label><span>輸入人員 <i>*</i></span><select v-model="form.inputUserId" required v-on:focus="loadUsers" v-on:change="conditionChanged"><option value="">請選擇輸入人員</option><option v-for="u in users" :key="u.userId" :value="u.userId">{{ u.userId }} | {{ u.userName }}</option></select></label></div>
<fieldset class="source-fieldset"><legend>計價類型 <i>*</i></legend><label class="source-option"><input v-model.number="form.chargeKind" type="radio" name="c7Kind" :value="0" v-on:change="conditionChanged"/><span>藥品</span></label><label class="source-option"><input v-model.number="form.chargeKind" type="radio" name="c7Kind" :value="1" v-on:change="conditionChanged"/><span>醫令</span></label></fieldset>
<p v-if="validationMessage" class="validation-message">{{ validationMessage }}</p><div class="form-actions"><button class="ghost-button" type="button" :disabled="isLoading" v-on:click="resetForm">重設</button><button class="primary-button" type="submit" :disabled="isLoading">{{ isLoading?'查詢中…':'⌕ 查詢' }}</button></div></form></div></section>
<section class="panel result-panel" :aria-busy="isLoading?'true':'false'"><div class="result-heading"><div><strong>查詢結果</strong><span v-if="!isLoading&&hasResults">共 {{ totalCount }} 筆</span></div><label v-if="!isLoading&&hasResults">每頁顯示<select v-model.number="pageSize" v-on:change="changePageSize"><option :value="10">10 筆</option><option :value="30">30 筆</option><option :value="50">50 筆</option></select></label></div>
<template v-if="isLoading"><span class="visually-hidden" role="status">資料查詢中</span>@await Html.PartialAsync("_TableSkeleton")</template><div v-else-if="!hasResults" class="empty-result"><div>▤</div><strong>{{ hasSearched?'查無資料':'尚無查詢結果' }}</strong><p>{{ hasSearched?'目前條件沒有符合的資料。':'請設定上方查詢條件後按下「查詢」。' }}</p></div><template v-else><div class="table-wrap"><table><thead><tr><th v-for="c in columns" :key="c.key">{{ c.value }}</th></tr></thead><tbody><tr v-for="(row,i) in rows" :key="i"><td v-for="c in columns" :key="c.key">{{ row[c.key] }}</td></tr></tbody></table></div><div class="pagination"><span>第 {{ currentPage }} / {{ totalPages }} 頁</span><div><button type="button" aria-label="第一頁" :disabled="currentPage===1" v-on:click="goToPage(1)">‹‹</button><button type="button" :disabled="currentPage===1" v-on:click="goToPage(currentPage-1)">‹</button><button class="active" type="button">{{ currentPage }}</button><button type="button" :disabled="currentPage===totalPages" v-on:click="goToPage(currentPage+1)">›</button><button type="button" aria-label="最後一頁" :disabled="currentPage===totalPages" v-on:click="goToPage(totalPages)">››</button></div></div></template></section>
<div v-if="previewOpen && previewHtml" class="report-preview-overlay" role="dialog" aria-modal="true" aria-label="C7 列印預覽"><div class="report-preview-actions no-print"><button class="ghost-button" type="button" v-on:click="closePreview">關閉預覽</button><button class="primary-button" type="button" v-on:click="printPreview">列印</button></div><article class="report-preview-paper" v-html="previewHtml"></article></div>
</div></template><script src="~/js/reports/c7-report.js" asp-append-version="true"></script>
