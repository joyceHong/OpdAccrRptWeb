<template id="m1-doctor-daily-template"><div>
<section class="page-title">
    <div>
        <span class="eyebrow">M1</span>
        <h1>{{ selectedReport.name }}</h1>
        <p>依日期查詢各科別、醫師的門診與急診看診人數。</p>
    </div>
    <div class="no-print">
        <button class="outline-button" type="button" :disabled="!hasResults||isLoading||previewLoading" v-on:click="openPreview">預覽／列印</button>
        <button class="outline-button" type="button" :disabled="!hasResults||isLoading" v-on:click="exportReport('xlsx')">Excel</button></div>
</section>
<section class="panel query-panel">
    <div>
        <div class="panel-title">
            <span>查詢條件</span>
                <small><i>*</i> 為必填欄位</small>
        </div>
        <form v-on:submit.prevent="search">
            <div class="date-row">
                <label><span>查詢日期 <i>*</i></span>
                <input v-model="form.reportDate" type="date" required v-on:change="conditionChanged" /></label>
            </div><p v-if="validationMessage" class="validation-message">{{ validationMessage }}</p>
            <div class="form-actions">
                <button class="ghost-button" type="button" :disabled="isLoading" v-on:click="resetForm">重設</button>
                <button class="primary-button" type="submit" :disabled="isLoading">⌕ 查詢</button>
            </div>
        </form>
    </div>
</section>
<section class="panel result-panel" :aria-busy="isLoading?'true':'false'">
    <div class="result-heading">
        <div><strong>查詢結果</strong>
            <span v-if="!isLoading&&hasResults">共 {{ totalCount }} 筆</span>
        </div>
        <label v-if="!isLoading&&hasResults">每頁顯示
        <select v-model.number="pageSize" v-on:change="changePageSize">
            <option :value="10">10 筆</option><option :value="30">30 筆</option><option :value="50">50 筆
            </option>
        </select>
        </label>
     </div>
    <template v-if="isLoading">
        <span class="visually-hidden" role="status">資料查詢中</span>@await Html.PartialAsync("_TableSkeleton")</template>
        <div v-else-if="!hasResults" class="empty-result">
            <div>▤</div><strong>{{ hasSearched?'查無任何資料':'尚無查詢結果' }}</strong><p>{{ hasSearched?'目前日期沒有符合的資料。':'請選擇查詢日期後按下「查詢」。' }}</p>
        </div>
    <template v-else><div class="table-wrap"><table><thead><tr><th v-for="column in columns" :key="column.key">{{ column.label }}</th></tr></thead><tbody><tr v-for="(row,index) in rows" :key="`${row.sectionNo}-${row.doctorNo}-${row.visitType}-${index}`"><td v-for="column in columns" :key="column.key">{{ row[column.key] }}</td></tr></tbody></table></div><div class="pagination"><span>第 {{ currentPage }} / {{ totalPages }} 頁</span><div><button type="button" aria-label="第一頁" :disabled="currentPage===1" v-on:click="goToPage(1)">‹‹</button><button type="button" aria-label="上一頁" :disabled="currentPage===1" v-on:click="goToPage(currentPage-1)">‹</button><button class="active" type="button">{{ currentPage }}</button><button type="button" aria-label="下一頁" :disabled="currentPage===totalPages" v-on:click="goToPage(currentPage+1)">›</button><button type="button" aria-label="最後一頁" :disabled="currentPage===totalPages" v-on:click="goToPage(totalPages)">››</button></div></div></template></section>
<div v-if="previewOpen&&previewHtml" class="report-preview-overlay m1-preview-overlay" role="dialog" aria-modal="true" aria-label="M1 列印預覽"><div class="report-preview-actions no-print"><button class="ghost-button" type="button" v-on:click="closePreview">關閉預覽</button><button class="primary-button" type="button" v-on:click="printPreview">列印</button></div><article class="report-preview-paper m1-preview-paper" v-html="previewHtml"></article></div>
</div>
</template>
<script src="~/js/reports/m1-doctor-daily-report.js" asp-append-version="true"></script>
