<template id="m2-doctor-monthly-template"><div>
<section class="page-title"><div><span class="eyebrow">M2</span><h1>{{ selectedReport.name }}</h1>
<p>依月份、診別、時段及是否採實際看診人數，查詢各科別醫師每日看診人數。</p></div>
<div class="no-print"><button class="outline-button" type="button" :disabled="!hasResults||isLoading" v-on:click="openPreview">預覽／列印</button>
<button class="outline-button" type="button" :disabled="!hasResults||isLoading" v-on:click="exportReport('xlsx')">Excel</button></div></section>
<section class="panel query-panel"><div><div class="panel-title"><span>查詢條件</span><small><i>*</i> 為必填欄位</small></div>
<form v-on:submit.prevent="search"><div class="query-basic-row"><label class="query-primary-field"><span>查詢月份 <i>*</i></span><input v-model="form.reportMonth" type="month" required v-on:change="conditionChanged" /></label><button class="advanced-filter-toggle" type="button" :aria-expanded="advancedOpen?'true':'false'" aria-controls="m2-advanced-filters" v-on:click="advancedOpen=!advancedOpen">進階篩選 <span v-if="activeFilterCount" class="active-filter-count">已套用 {{ activeFilterCount }} 項</span><span class="chevron" :class="{open:advancedOpen}">⌄</span></button></div><div v-show="advancedOpen" id="m2-advanced-filters" class="advanced-grid" :class="['advanced-filter-region','open']">
<label><span>診別</span><select v-model.number="form.visitScope" v-on:change="conditionChanged"><option :value="0">門急診</option><option :value="1">門診</option><option :value="2">急診</option></select></label>
<label><span>時段</span><select v-model.number="form.timeSlot" v-on:change="conditionChanged"><option :value="0">全部</option><option :value="1">上午</option><option :value="2">下午</option><option :value="3">夜間</option></select></label>
</div><fieldset class="source-fieldset"><legend>計算方式</legend><label class="source-option"><input v-model="form.actualVisit" type="checkbox" v-on:change="conditionChanged" /><span>實際看診人數</span></label></fieldset><p v-if="validationMessage" class="validation-message">{{ validationMessage }}</p><div class="form-actions">
<button class="ghost-button" type="button" :disabled="isLoading" v-on:click="resetForm">重設</button><button class="primary-button" type="submit" :disabled="isLoading">⌕ 查詢</button></div></form></div></section>
<section class="panel result-panel" :aria-busy="isLoading?'true':'false'"><div class="result-heading"><div><strong>查詢結果</strong><span v-if="!isLoading&&hasResults">共 {{ totalCount }} 筆</span></div>
<label v-if="!isLoading&&hasResults">每頁顯示 <select v-model.number="pageSize" v-on:change="changePageSize"><option :value="10">10 筆</option><option :value="30">30 筆</option><option :value="50">50 筆</option></select></label></div>
<template v-if="isLoading"><span class="visually-hidden" role="status">資料查詢中</span>@await Html.PartialAsync("_TableSkeleton")</template>
<div v-else-if="!hasResults" class="empty-result"><div>▤</div><strong>{{ hasSearched?'查無任何資料':'尚無查詢結果' }}</strong><p>{{ hasSearched?'目前條件沒有符合的資料。':'請選擇查詢條件後按下「查詢」。' }}</p></div>
<template v-else><div class="table-wrap m2-monthly-table"><table><thead><tr><th class="m2-sticky m2-sticky-1">科別代碼</th><th class="m2-sticky m2-sticky-2">科別名稱</th><th class="m2-sticky m2-sticky-3">醫師代碼</th><th class="m2-sticky m2-sticky-4">醫師姓名</th><th v-for="day in 31" :key="day">{{ String(day).padStart(2,'0') }}</th><th>合計</th></tr></thead>
<tbody><tr v-for="row in rows" :key="`${row.sectionNo}-${row.doctorNo}`"><td class="m2-sticky m2-sticky-1">{{ row.sectionNo }}</td><td class="m2-sticky m2-sticky-2">{{ row.sectionName }}</td><td class="m2-sticky m2-sticky-3">{{ row.doctorNo }}</td><td class="m2-sticky m2-sticky-4">{{ row.doctorName }}</td><td v-for="(count,index) in row.dailyCounts" :key="index">{{ count }}</td><td>{{ row.monthlyTotal }}</td></tr></tbody></table></div>
<div class="pagination"><span>第 {{ currentPage }} / {{ totalPages }} 頁</span><div><button type="button" aria-label="第一頁" :disabled="currentPage===1" v-on:click="goToPage(1)">‹‹</button><button type="button" aria-label="上一頁" :disabled="currentPage===1" v-on:click="goToPage(currentPage-1)">‹</button><button class="active" type="button">{{ currentPage }}</button><button type="button" aria-label="下一頁" :disabled="currentPage===totalPages" v-on:click="goToPage(currentPage+1)">›</button><button type="button" aria-label="最後一頁" :disabled="currentPage===totalPages" v-on:click="goToPage(totalPages)">››</button></div></div></template></section>
<div v-if="previewOpen&&previewHtml" class="report-preview-overlay m2-preview-overlay" role="dialog" aria-modal="true" aria-label="M2 列印預覽"><div class="report-preview-actions no-print"><button class="ghost-button" type="button" v-on:click="closePreview">關閉預覽</button><button class="primary-button" type="button" v-on:click="printPreview">列印</button></div><article class="report-preview-paper m2-preview-paper" v-html="previewHtml"></article></div>
</div></template>
<script src="~/js/reports/m2-doctor-monthly-report.js" asp-append-version="true"></script>
