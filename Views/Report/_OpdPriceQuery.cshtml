<script type="text/x-template" id="opd-price-query-template">
    <section class="report-page q1-report">
       @*   <div class="breadcrumb">資料查詢 <span>›</span> 批價查詢</div>  *@

        <div class="q1-top-grid">
        <div class="panel query-panel">
            <div class="panel-title">
                <h1>批價查詢</h1>
                <span class="report-code">Q1</span>
            </div>

            <form v-on:submit.prevent="search">
                <div class="q1-basic-row" :class="'query-basic-row'">
                    <label class="q1-medical-record-field" :class="'query-primary-field'">
                        <span>病歷號 <i>*</i></span>
                        <input v-model.trim="form.medicalRecordNo" autocomplete="off" required />
                    </label>
                    <div class="q1-basic-actions" :class="'query-actions'">
                        <button class="primary-button" type="submit" :disabled="loading">{{ loading ? '查詢中…' : '⌕ 查詢' }}</button>
                        <button class="ghost-button" type="button" :disabled="loading" v-on:click="reset">↺ 重設</button>
                        <button class="q1-filter-toggle" :class="'advanced-filter-toggle'" type="button" :aria-expanded="advancedOpen ? 'true' : 'false'"
                                aria-controls="q1-advanced-filters" v-on:click="advancedOpen = !advancedOpen">
                            進階篩選 <span v-if="activeFilterCount" class="active-filter-count">已套用 {{ activeFilterCount }} 項</span><span class="chevron" :class="{ open: advancedOpen }">⌄</span>
                        </button>
                    </div>
                </div>

                <div id="q1-advanced-filters" class="q1-advanced-collapse" :class="['advanced-filter-region', { open: advancedOpen }]" :aria-hidden="advancedOpen ? 'false' : 'true'" :inert="!advancedOpen">
                    <div class="q1-advanced-content" :class="'advanced-filter-content'">
                        <div class="advanced-grid">
                            <label><span>就診日期</span><input type="date" v-model="form.visitDate" /></label>
                            <label><span>科別</span>
                                <report-autocomplete v-model="form.sectionQuery" id-prefix="q1-section"
                                                     placeholder="輸入新科別碼或中文名稱"
                                                     :options="normalizedSectionOptions" :open="sectionOpen"
                                                     v-on:input="loadSections" v-on:select="selectSectionOption"
                                                     v-on:update:open="sectionOpen = $event" />
                            </label>
                            <label class="check-field"><input type="checkbox" v-model="form.showDc" /> 顯示 DC</label>
                            <label class="check-field"><input type="checkbox" v-model="form.showExtendedCode" /> 顯示延伸碼</label>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        <section class="panel q1-patient-panel" aria-label="病患資料">
            <div class="panel-title"><h2>病患資料</h2></div>
            <div class="q1-patient-content">
                <div v-if="patientLoading" role="status"><partial name="_TableSkeleton" /><span class="visually-hidden">病患資料載入中</span></div>
                <div v-else-if="selectedDetail" class="q1-patient-fields">
                    <dl class="q1-patient">
                        <dt>病歷號</dt><dd>{{selectedDetail.patient.medicalRecordNo}}</dd>
                        <dt>姓名</dt><dd>{{selectedDetail.patient.name}}</dd>
                        <dt>生日</dt><dd>{{selectedDetail.patient.birthday}}</dd>
                        <dt>身分證號</dt><dd>{{selectedDetail.patient.identityNumber}}</dd>
                        <dt>醫師</dt><dd>{{selectedDetail.encounter.doctorName}}</dd>
                        <dt>診間</dt><dd>{{selectedDetail.encounter.room}}</dd>
                        <dt>身份別</dt><dd>{{selectedDetail.encounter.identityType}}</dd>
                        <dt>折扣別</dt><dd>{{selectedDetail.encounter.discountType}}</dd>
                        <dt>健保序號</dt><dd>{{selectedDetail.encounter.insuranceSequence}}</dd>
                        <dt>部分負擔</dt><dd>{{selectedDetail.encounter.copayment}}</dd>
                    </dl>
                    <div class="q1-diagnoses"><span v-for="(code,index) in selectedDetail.encounter.diagnoses" :key="index">診斷 {{index+1}}：{{code || '—'}}</span></div>
                </div>
                <p v-else class="q1-patient-placeholder">{{ patientError || '請先查詢並選取就診紀錄。' }}</p>
            </div>
        </section>
        </div>

        <div v-if="error" class="validation-summary">{{error}}</div>

        <template v-if="loading">
            <partial name="_TableSkeleton" />
            <span class="visually-hidden" role="status">資料查詢中</span>
        </template>

        <section v-else class="panel result-panel">
            <div class="result-heading">
                <strong>查詢結果</strong>
                <span v-if="searched">共 {{totalCount}} 筆</span>
            </div>

            <div v-if="!visits.length" class="empty-result">
                <div>▤</div>
                <strong>{{ searched ? '查無資料' : '尚無查詢結果' }}</strong>
                <p>{{ searched ? '目前條件沒有符合的資料，請調整病歷號或進階篩選條件後再查詢。' : '請輸入病歷號並點擊「查詢」，即可查看就診與批價資料。' }}</p>
            </div>

            <template v-else>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>就診日</th>
                                <th>時段</th>
                                <th>診間</th>
                                <th>掛號序號</th>
                                <th>科別</th>
                                <th>健保序號</th>
                                <th>狀態</th>
                                <th>明細</th>
                                <th>收據</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr
                                v-for="row in visits"
                                :key="row.visitToken"
                                tabindex="0"
                                v-on:click="selectVisit(row)"
                                v-on:keydown.enter="selectVisit(row)"
                                v-on:keydown.space.prevent="selectVisit(row)"
                                :class="{selected:selectedToken===row.visitToken}">
                                <td>{{row.visitDate}}</td>
                                <td>{{row.visitTime}}</td>
                                <td>{{row.room}}</td>
                                <td>{{row.registrationNo}}</td>
                                <td>{{row.sectionCode}}</td>
                                <td>{{row.insuranceSequence}}</td>
                                <td>{{row.cancellationLabel}}</td>
                                <td><button type="button" class="q1-row-action q1-row-action-detail" v-on:click.stop="openDetail(row,$event)">明細</button></td>
                                <td><button type="button" class="q1-row-action q1-row-action-receipt" v-on:click.stop="openReceipts(row,$event)">收據</button></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="pagination">
                    <button type="button" aria-label="第一頁" :disabled="pageNumber===1" v-on:click="goToPage(1)">‹‹</button>
                    <button type="button" :disabled="pageNumber===1" v-on:click="goToPage(pageNumber-1)">‹</button>
                    <span>{{pageNumber}} / {{Math.max(totalPages,1)}}</span>
                    <button type="button" :disabled="pageNumber>=totalPages" v-on:click="goToPage(pageNumber+1)">›</button>
                    <button type="button" aria-label="最後一頁" :disabled="pageNumber>=totalPages" v-on:click="goToPage(totalPages)">››</button>
                </div>
            </template>
        </section>

        <div v-if="modalKind" class="q1-modal-backdrop" v-on:click.self="closeModal">
            <section class="q1-modal panel" role="dialog" aria-modal="true" :aria-label="modalKind === 'detail' ? '就診明細' : '收據列表'" v-on:keydown.esc.stop="closeModal">
                <header class="q1-modal-header">
                    <div><h2>{{modalKind === 'detail' ? '就診明細' : '收據列表'}}</h2>
                        <p v-if="modalVisit">{{modalDetail?.patient?.name || '載入中'}}／{{modalDetail?.patient?.medicalRecordNo || '—'}}　{{modalVisit.visitDate}} {{modalVisit.visitTime}} {{modalVisit.room}}／{{modalVisit.registrationNo}}</p>
                    </div>
                    <button ref="modalClose" type="button" v-on:click="closeModal" aria-label="關閉視窗">×</button>
                </header>
                <div v-if="modalLoading" class="q1-modal-state" role="status"><partial name="_TableSkeleton" /><span class="visually-hidden">資料載入中</span></div>
                <div v-else-if="modalError" class="validation-summary" role="alert">{{modalError}}</div>
                <template v-else-if="modalDetail && modalKind === 'detail'">
                    <section v-for="group in chargeGroups" :key="group.name" class="q1-charge-section">
                        <h3>{{group.name}}</h3>
                        <p v-if="!group.rows.length" class="q1-modal-state">無資料</p>
                        <div v-else class="table-wrap"><table><thead><tr>
                            <th>類型</th><th>代碼</th><th>名稱</th><th>劑量</th><th>頻率</th><th>天數</th><th>成數</th><th>總量</th><th>費別</th><th>單價</th><th>總價</th><th>狀態</th><th>輸入日</th><th>輸入人</th><th>計價日</th><th>刪除日</th><th>刪除人</th><th>報告／領藥號</th><th v-if="group.name === '醫令明細'">執行日</th><th v-if="group.name === '醫令明細'">執行醫師</th><template v-if="showFemhColumns"><th v-for="n in 6" :key="n">Sub{{n}}</th><th v-if="group.name === '藥令明細'">藥品計價日</th></template><th v-if="showReceiptSequence">收據序號</th>
                        </tr></thead><tbody><tr v-for="(row,index) in group.rows" :key="index">
                            <td>{{row.category}}</td><td>{{row.code}}</td><td>{{row.name}}</td><td>{{row.dose}}</td><td>{{row.frequency}}</td><td>{{row.days}}</td><td>{{row.daysOrPercent}}</td><td>{{row.quantity}}</td><td>{{row.paymentLabel}}</td><td>{{row.unitPrice}}</td><td>{{row.amount}}</td><td>{{row.status}}</td><td>{{row.inputDate}}</td><td>{{row.inputUser}}</td><td>{{row.priceDate}}</td><td>{{row.deleteDate}}</td><td>{{row.deleteUser}}</td><td>{{row.reportOrPickupNo}}</td><td v-if="group.name === '醫令明細'">{{row.executionDate}}</td><td v-if="group.name === '醫令明細'">{{row.executionDoctor}}</td><template v-if="showFemhColumns"><td v-for="n in 6" :key="n">{{row.subAmounts[n-1]}}</td><td v-if="group.name === '藥令明細'">{{row.prescriptionDate}}</td></template><td v-if="showReceiptSequence">{{row.receiptSequence}}</td>
                        </tr></tbody></table></div>
                    </section>
                </template>
                <template v-else-if="modalDetail && modalKind === 'receipts'">
                    <p v-if="!modalDetail.receipts.length" class="q1-modal-state">無收據資料</p>
                    <div v-else class="table-wrap"><table><thead><tr><th>勾選</th><th>收據號</th><th>結帳日期</th><th>結帳者</th><th>應收</th><th>現金</th><th>支票</th><th>刷卡</th><th>記帳</th><th>社服</th><th>DC 日期</th><th>DC 人員</th></tr></thead><tbody>
                        <tr v-for="row in modalDetail.receipts" :key="row.receiptToken || row.receiptNo"><td><input type="checkbox" :disabled="!row.receiptToken" :checked="selectedReceipts.includes(row.receiptToken)" v-on:change="toggleReceipt(row.receiptToken,$event.target.checked)" :aria-label="'勾選收據 '+row.receiptNo" /><span v-if="!row.receiptToken">此收據狀態不可列印</span></td><td>{{row.receiptNo}}</td><td>{{row.checkoutDate}}</td><td>{{row.checkoutUser}}</td><td>{{row.receivable}}</td><td>{{row.cash}}</td><td>{{row.check}}</td><td>{{row.card}}</td><td>{{row.onAccount}}</td><td>{{row.socialService}}</td><td>{{row.dcDate}}</td><td>{{row.dcUser}}</td></tr>
                    </tbody></table></div>
                </template>
                <footer class="q1-modal-actions">
                    <button v-if="modalKind === 'receipts'" type="button" class="primary-button" :disabled="!selectedReceipts.length || printPending || modalLoading" v-on:click="printSelectedReceipts">{{printPending ? '產生預覽中…' : '列印已勾選收據'}}</button>
                    <button type="button" class="ghost-button" v-on:click="closeModal">關閉</button>
                </footer>
            </section>
        </div>
    </section>
</script>
