<div class="table-wrap table-skeleton" aria-hidden="true">
    <table>
        <thead>
            <tr>
                <th><span class="skeleton-line skeleton-line-heading"></span></th>
                <th><span class="skeleton-line skeleton-line-heading"></span></th>
                <th><span class="skeleton-line skeleton-line-heading"></span></th>
                <th><span class="skeleton-line skeleton-line-heading"></span></th>
            </tr>
        </thead>
        <tbody>
            @for (int rowIndex = 0; rowIndex < 10; rowIndex++)
            {
                <tr>
                    <td><span class="skeleton-line skeleton-line-short"></span></td>
                    <td><span class="skeleton-line skeleton-line-medium"></span></td>
                    <td><span class="skeleton-line skeleton-line-long"></span></td>
                    <td><span class="skeleton-line skeleton-line-medium"></span></td>
                </tr>
            }
        </tbody>
    </table>
</div>
