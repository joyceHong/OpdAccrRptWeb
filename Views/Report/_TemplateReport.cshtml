<script src="~/js/reports/report-template.js" asp-append-version="true"></script>
<template id="report-template">
    <div>
        <section class="page-title">
            <div>
                <span class="eyebrow">{{ selectedReport ? selectedReport.code : 'REPORT' }}</span>
                <h1>{{ selectedReport ? selectedReport.name : '請從左側選擇報表' }}</h1>
                <p>設定查詢區間與條件，送出後即可檢視報表資料。</p>
            </div>
            <button v-if="isC13" class="outline-button no-print" type="button" :disabled="!hasResults || isLoading || legacyPreviewLoading" v-on:click="previewC13">{{ legacyPreviewLoading ? '載入預覽…' : '預覽／列印' }}</button>
            <button v-else-if="isC3" class="outline-button no-print" type="button" :disabled="!hasResults || isLoading || c3PreviewLoading" v-on:click="openC3Preview">{{ c3PreviewLoading ? '載入完整預覽…' : '預覽／列印' }}</button>
            <template v-else-if="isC4">
                <button class="outline-button no-print" type="button" :disabled="!hasResults || isLoading || c4PreviewLoading" v-on:click="openC4Preview">{{ c4PreviewLoading ? '載入完整預覽…' : '預覽／列印' }}</button>
            </template>
            <button v-else-if="isC16" class="outline-button no-print" type="button" :disabled="!hasResults || isLoading || legacyPreviewLoading" v-on:click="previewC16">{{ legacyPreviewLoading ? '載入預覽…' : '預覽／列印' }}</button>
            <button v-else-if="isC15" class="outline-button no-print" type="button" :disabled="!hasResults || isLoading || c15PreviewLoading" v-on:click="openC15Preview">{{ c15PreviewLoading ? '載入完整預覽…' : '預覽／列印' }}</button>
            <button v-else-if="!isPrintableLegacyReport" class="outline-button" type="button" :disabled="!canExport" v-on:click="exportResults">
                {{ isExporting ? '⌛ 匯出處理中…' : '⇩ 匯出 Excel' }}
            </button>
            <button v-else class="outline-button no-print" type="button" :disabled="!hasResults" v-on:click="printC211">列印</button>
        </section>
        <section v-if="exportJob" class="export-status" role="status" aria-live="polite">
            <strong>Excel 匯出：{{ exportJob.status }}</strong>
            <span v-if="exportJob.status === 'Queued'">等待系統處理。</span>
            <span v-else-if="exportJob.status === 'Running'">正在產生完整報表。</span>
            <a v-else-if="exportJob.status === 'Ready' && exportJob.downloadUrl" :href="exportJob.downloadUrl">下載完成的 Excel</a>
            <span v-else>{{ exportJob.message || '工作已結束，請重新申請匯出。' }}</span>
        </section>
        <section class="panel query-panel">
            <div>
                <div class="panel-title">
                    <span>查詢條件</span>
                    <small><i>*</i> 為必填欄位</small>
                </div>
                <form v-on:submit.prevent="search">
                    <div class="date-row">
                        <label v-if="!isEndDateOnly"><span>起始日期 <i>*</i></span><input v-model="form.startDate" type="date" required v-on:change="currentPage = 1" /></label>
                        <span v-if="!isEndDateOnly" class="date-arrow">→</span>
                        <label><span>截止日期 <i>*</i></span><input v-model="form.endDate" type="date" required v-on:change="currentPage = 1" /></label>
                        <button v-if="isC143" class="ghost-button" type="button" v-on:click="useYesterday">改成昨天</button>
                    </div>
                    <fieldset v-if="hasEncounterSource" class="source-fieldset">
                        <legend>就醫來源 <i>*</i></legend>
                        <label v-for="option in encounterSourceConfiguration.options" :key="option.value" class="source-option">
                            <input
                                v-model="form.encounterSource"
                                type="radio"
                                name="encounterSource"
                                :value="option.value"
                                required
                                v-on:change="changeEncounterSource" />
                            <span>{{ option.label }}</span>
                        </label>
                    </fieldset>
                    <fieldset v-if="hasReportType" class="source-fieldset">
                        <legend>報表類型 <i>*</i></legend>
                        <label v-for="option in reportTypeConfiguration.options" :key="option.value" class="source-option">
                            <input v-model="form.reportType" type="radio" name="reportType" :value="option.value"
                                   required v-on:change="changeC143ReportType" />
                            <span>{{ option.label }}</span>
                        </label>
                    </fieldset>
                    <template v-if="isC3">
                        <fieldset class="source-fieldset">
                            <legend>報表內容 <i>*</i></legend>
                            <label class="source-option"><input v-model.number="form.detailType" type="radio" name="c3Detail" :value="0" v-on:change="currentPage=1" /><span>彙總</span></label>
                            <label class="source-option"><input v-model.number="form.detailType" type="radio" name="c3Detail" :value="1" v-on:change="currentPage=1" /><span>明細</span></label>
                        </fieldset>
                        <fieldset class="source-fieldset">
                            <legend>物流類型 <i>*</i></legend>
                            <label class="source-option"><input v-model.number="form.logisticsType" type="radio" name="c3Logistics" :value="0" v-on:change="currentPage=1" /><span>全部</span></label>
                            <label class="source-option"><input v-model.number="form.logisticsType" type="radio" name="c3Logistics" :value="1" v-on:change="currentPage=1" /><span>物流</span></label>
                            <label class="source-option"><input v-model.number="form.logisticsType" type="radio" name="c3Logistics" :value="2" v-on:change="currentPage=1" /><span>非物流</span></label>
                        </fieldset>
                        <div class="advanced-grid">
                            <label><span>領用部門</span><input v-model.trim="form.departmentCode" v-on:input="currentPage=1" maxlength="10" /></label>
                            <label><span>診間（逗號分隔）</span><input v-model="form.roomCodes" v-on:input="currentPage=1" /></label>
                            <label><span>批價碼（逗號分隔）</span><input v-model="form.chargeCodes" v-on:input="currentPage=1" /></label>
                        </div>
                    </template>
                    <div v-if="isC4" class="advanced-grid">
                        <label><span>科別／部門</span>
                            <div class="report-autocomplete">
                                <input v-model="form.organizationQuery" autocomplete="off" placeholder="輸入新碼或名稱"
                                       role="combobox" aria-autocomplete="list" aria-controls="c4-organization-options"
                                       :aria-expanded="c4Organizations.length ? 'true' : 'false'"
                                       v-on:input="onC4OrganizationInput" />
                                <div v-if="c4Organizations.length" id="c4-organization-options"
                                     class="report-autocomplete-panel" role="listbox">
                                    <button v-for="item in c4Organizations" :key="`${item.source}-${item.legacyCode}`"
                                            type="button" class="report-autocomplete-option" role="option"
                                            v-on:mousedown.prevent="selectC4Organization(item)">
                                        <strong>{{ item.newCode }}</strong>
                                        <span>{{ item.displayName }}（{{ item.source }}）</span>
                                    </button>
                                </div>
                            </div>
                        </label>
                    </div>
                    <fieldset v-if="isC16" class="source-fieldset">
                        <legend>日期基準 <i>*</i></legend>
                        <label class="source-option"><input v-model="form.dateMode" type="radio" name="c16DateBasis" value="AccountingDate" required /><span>帳務日</span></label>
                        <label class="source-option"><input v-model="form.dateMode" type="radio" name="c16DateBasis" value="VisitDate" :disabled="form.encounterSource === 'Inpatient'" required /><span>就診日</span></label>
                        <small v-if="form.encounterSource === 'Inpatient'">住院固定依帳務日查詢</small>
                    </fieldset>
                    <fieldset v-if="hasReceivableBalanceType" class="source-fieldset">
                        <legend>餘額類型 <i>*</i></legend>
                        <label v-for="option in receivableBalanceTypeConfiguration.options" :key="option.value" class="source-option">
                            <input
                                v-model="form.receivableBalanceType"
                                type="radio"
                                name="receivableBalanceType"
                                :value="option.value"
                                required
                                v-on:change="changeReceivableBalanceType" />
                            <span>{{ option.label }}</span>
                        </label>
                    </fieldset>
                    <div v-if="isC21" class="advanced-grid">
                        <label>
                            <span>{{ form.encounterSource === 'Inpatient' ? '住院別' : '門急診選項' }}</span>
                            <select v-model.number="form.accountingScope">
                                <option v-for="option in c21ScopeOptions" :key="option.value" :value="option.value">{{ option.label }}</option>
                            </select>
                        </label>
                        <label><span>收費科目</span><select v-model="form.billingCode"><option value="">全部</option><option v-for="item in c21BillingItems" :key="item.code" :value="item.code">{{ item.code }} : {{ item.name }}</option></select></label>
                        <label v-if="canForceC21Rebuild" class="source-option">
                            <input v-model="form.forceRebuild" type="checkbox" />
                            <span>重新計算</span>
                        </label>
                    </div>
                    <div v-if="isC23" class="advanced-grid">
                        <label><span>日期模式 <i>*</i></span><select v-model="form.dateMode" v-on:change="changeC23DateMode"><option value="General">一般日期</option><option value="EncounterDate">就診日</option></select></label>
                        <label v-if="form.encounterSource === 'Inpatient' && form.dateMode === 'General'"><span>住院別 <i>*</i></span><select v-model="form.inpatientType" required><option value="" disabled>請選擇</option><option value="Inpatient">住院</option><option value="Discharged">出院</option></select></label>
                        <label><span>合約代碼</span><select v-model="form.contractCode"><option value="">全部</option><option v-for="item in c23Contracts" :key="item.code" :value="item.code">{{ item.code }} : {{ item.name }}</option></select></label>
                        <label v-if="canForceC23Rebuild" class="source-option"><input v-model="form.forceRebuild" type="checkbox" /><span>重建</span></label>
                    </div>
                    <div v-if="isC211" class="advanced-grid c211-contract-input">
                        <label><span>合約單位</span><div ref="c211Autocomplete" class="report-autocomplete"><input v-model="form.contractCode" autocomplete="off" placeholder="全部／可直接輸入代碼" role="combobox" aria-autocomplete="list" aria-controls="c211-contract-list" :aria-expanded="c211ContractOpen ? 'true' : 'false'" :aria-activedescendant="c211ContractActiveIndex >= 0 ? `c211-contract-option-${c211ContractActiveIndex}` : undefined" v-on:focus="openC211Contracts" v-on:input="openC211Contracts" v-on:keydown="onC211ContractKeydown" /><div v-if="c211ContractOpen && filteredC211Contracts.length" id="c211-contract-list" class="report-autocomplete-panel" role="listbox"><button v-for="(item,index) in filteredC211Contracts" :id="`c211-contract-option-${index}`" :key="item.code" type="button" class="report-autocomplete-option" :class="{ active: index === c211ContractActiveIndex }" role="option" :aria-selected="index === c211ContractActiveIndex ? 'true' : 'false'" v-on:mouseenter="c211ContractActiveIndex=index" v-on:mousedown.prevent="selectC211Contract(item)"><strong>{{ item.code }}</strong><span>{{ item.name }}</span></button></div></div></label>
                    </div>
                    <div v-if="isC24 || isC10" class="advanced-grid">
                        <label v-if="isC24"><span>模式 <i>*</i></span><select v-model="form.mode" v-on:change="changeC24Mode"><option value="Accounting">會計</option><option value="Billing">批價作業</option></select></label>
                        <label><span>門急診別 <i>*</i></span><select v-if="isC10" v-model="form.roomScope" :disabled="form.source === 'Inpatient'"><option value="All">全部</option><option value="Emergency">急診</option><option value="Outpatient">門診</option></select><select v-else v-model="form.roomScope" :disabled="form.source === 'Inpatient'"><option value="All">全部</option><option value="Emergency">急診</option><option value="NonEmergency">門診</option></select></label>
                        <label><span>病歷號</span><input v-model.trim="form.medicalRecordNo" maxlength="10" /></label>
                        <label v-if="canForceC24Rebuild" class="source-option"><input v-model="form.forceRebuild" type="checkbox" /><span>重建</span></label>
                    </div>
                    <button v-if="hasAdvancedConditions" class="advanced-toggle" type="button" v-on:click="advancedOpen = !advancedOpen">
                        <span><strong>進階條件</strong><small>（選填）</small></span>
                        <span>{{ advancedOpen ? '收合 ︿' : '展開 ﹀' }}</span>
                    </button>
                    <div v-if="hasAdvancedConditions" v-show="advancedOpen" class="advanced-grid">
                        <label v-if="hasStationOrBedPrefix"><span>護理站／床號前綴</span><input v-model.trim="form.stationOrBedPrefix" placeholder="例如：7A" /></label>
                        <label v-if="hasCashierUserId"><span>批價員代碼</span><input v-model.trim="form.cashierUserId" placeholder="請輸入批價員代碼" /></label>
                        <label v-if="hasCashierCashSort"><span>排序方式 <i>*</i></span><select v-model="form.cashierCashSortType" required><option v-for="option in cashierCashSortConfiguration.options" :key="option.value" :value="option.value">{{ option.label }}</option></select></label>
                        <label v-if="hasBillingCode"><span>合約代碼</span><input v-model.trim="form.billingCode" placeholder="空白代表全部合約" /></label>
                      @*   <template v-if="!hasStationOrBedPrefix && !hasCashierUserId && !hasBillingCode">
                            <label><span>科別</span><select v-model="form.department"><option value="">全部科別</option><option>內科</option><option>外科</option><option>急診醫學科</option></select></label>
                            <label><span>診間</span><input v-model.trim="form.clinic" placeholder="請輸入診間" /></label>
                            <label><span>醫院代碼</span><input v-model.trim="form.hospitalCode" placeholder="請輸入醫院代碼" /></label>
                            <label><span>批價碼</span><input v-model.trim="form.billingCode" placeholder="請輸入批價碼" /></label>
                        </template> *@
                    </div>
                    <p v-if="validationMessage" class="validation-message">{{ validationMessage }}</p>
                    <div class="form-actions">
                        <button class="ghost-button" type="button" :disabled="isLoading" v-on:click="resetForm">重設</button>
                        <button class="primary-button" type="submit" :disabled="isLoading">{{ isLoading ? '查詢中…' : '⌕ 查詢' }}</button>
                    </div>
                </form>
            </div>
        </section>
        <section class="panel result-panel" :aria-busy="isLoading ? 'true' : 'false'">
            <div v-if="isC24 && summaries.length" class="result-heading">
                <span v-for="item in summaries" :key="item.roomCategory">{{ item.roomCategory }}：欠款 {{ item.debtAmount }}／補繳 {{ item.paymentAmount }}／未清 {{ item.outstandingAmount }}</span>
            </div>
            <div class="result-heading">
                <div>
                    <strong>查詢結果</strong>
                    <span v-if="!isLoading && hasResults">共 {{ totalCount }} 筆</span>
                </div>
                <label v-if="!isLoading && hasResults && !isPrintableLegacyReport">
                    每頁顯示
                    <select v-model.number="pageSize" :disabled="isLoading" v-on:change="changePageSize">
                        <option :value="10">10 筆</option>
                        <option :value="30">30 筆</option>
                        <option :value="50">50 筆</option>
                    </select>
                </label>
            </div>
            <template v-if="isLoading">
                <span class="visually-hidden" role="status">資料查詢中</span>
                <partial name="_TableSkeleton" />
            </template>
            <div v-else-if="!hasResults" class="empty-result">
                <div>▤</div>
                <strong>{{ hasSearched ? (isPrintableLegacyReport ? '查無資料！' : '查無資料') : '尚無查詢結果' }}</strong>
                <p>{{ hasSearched ? '目前條件沒有符合的資料。' : '請設定上方查詢條件後按下「查詢」。' }}</p>
            </div>
            <div v-else-if="isC15" class="c15-report">
                <section v-for="group in c15Groups" :key="group.type" class="c15-group">
                    <div class="table-wrap">
                        <table>
                            <thead><tr><th>租借日期</th><th>病歷號</th><th>租借人</th><th>輔具編號</th><th>租借期限</th><th class="amount">{{ group.amount001Label }}</th><th>歸還日期</th><th class="amount">{{ group.amount002Label }}</th><th class="amount">{{ group.amount004Label }}</th><th class="amount">{{ group.amount003Label }}</th></tr></thead>
                            <tbody><tr v-for="row in group.rows" :key="row.encounterOrdinal"><td>{{ row.visitDate }}</td><td>{{ row.medicalRecordNumber }}</td><td>{{ row.patientName }}</td><td>{{ row.deviceNumber }}</td><td>{{ row.rentalPeriod }}</td><td class="amount">{{ row.rl001 }}</td><td>{{ row.returnDate }}</td><td class="amount">{{ row.rl002 }}</td><td class="amount">{{ row.rl004 }}</td><td class="amount">{{ row.rl003 }}</td></tr></tbody>
                            <tfoot><tr><th colspan="5">合計</th><th class="amount">{{ group.rl001Total }}</th><th></th><th class="amount">{{ group.rl002Total }}</th><th class="amount">{{ group.rl004Total }}</th><th class="amount">{{ group.rl003Total }}</th></tr></tfoot>
                        </table>
                    </div>
                </section>
            </div>
            <div v-else-if="isC211" class="c211-report">
                <header class="c211-report-header">
                    <h2>{{ c211Summary.title }}</h2>
                    <p>{{ c211Summary.reportDate }}</p>
                    <small>{{ c211Summary.programNo }}／{{ c211Summary.reportNo }}　{{ c211Summary.processDateTime }}　{{ c211Summary.editUser }}</small>
                </header>
                <section v-for="group in c211Groups" :key="group.contractCode" class="c211-group">
                    <h3>合約身分：{{ group.contractCode }}</h3>
                    <table>
                        <thead><tr><th>病歷號</th><th>就診日期</th><th class="amount">一般身分合約金額</th><th class="amount">健保身分合約金額</th></tr></thead>
                        <tbody><tr v-for="(row, index) in group.rows" :key="`${group.contractCode}-${index}`"><td>{{ row.medicalRecordNo }}</td><td>{{ row.visitDate }}</td><td class="amount">{{ row.selfAmount }}</td><td class="amount">{{ row.claimAmount }}</td></tr></tbody>
                        <tfoot><tr><th colspan="2">合約小計</th><th class="amount">{{ group.selfAmount }}</th><th class="amount">{{ group.claimAmount }}</th></tr></tfoot>
                    </table>
                </section>
                <footer class="c211-grand-total"><strong>報表總計</strong><span>一般：{{ c211Summary.selfGrandTotal }}</span><span>健保：{{ c211Summary.claimGrandTotal }}</span></footer>
            </div>
            <div v-else-if="isC212" class="c212-report">
                <header class="c211-report-header">
                    <h2>{{ c212Summary.title }}</h2>
                    <p>{{ c212Summary.reportDate }}</p>
                    <small>{{ c212Summary.programNo }}／{{ c212Summary.reportNo }}　{{ c212Summary.processDateTime }}　{{ c212Summary.editUser }}</small>
                    <p class="c212-freshness-warning" role="alert">{{ c212Summary.dataStatusMessage }}</p>
                </header>
                <table>
                    <thead><tr><th>日期</th><th>病歷號</th><th>姓名</th><th class="amount">金額</th></tr></thead>
                    <tbody><tr v-for="(row, index) in rows" :key="index"><td>{{ row.accountingDate }}</td><td>{{ row.medicalRecordNo }}</td><td>{{ row.patientName }}</td><td class="amount">{{ row.amount }}</td></tr></tbody>
                    <tfoot><tr><th colspan="3">合計</th><th class="amount">{{ c212Summary.totalAmount }}</th></tr></tfoot>
                </table>
            </div>
            <div v-else class="table-wrap">
                <table>
                    <thead><tr><th v-for="column in columns" :key="column.key">{{ column.label }}</th></tr></thead>
                    <tbody><tr v-for="row in pagedRows" :key="row.id"><td v-for="column in columns" :key="column.key">{{ row[column.key] }}</td></tr></tbody>
                </table>
            </div>
            <template v-if="!isPrintableLegacyReport">
                <div v-if="!isLoading && hasResults" class="pagination">
                    <span>第 {{ currentPage }} / {{ totalPages }} 頁</span>
                    <div>
                        <button type="button" aria-label="第一頁" :disabled="isLoading || currentPage === 1" v-on:click="goToPage(1)">‹‹</button>
                        <button type="button" :disabled="isLoading || currentPage === 1" v-on:click="goToPage(currentPage - 1)">‹</button>
                        <button class="active" type="button">{{ currentPage }}</button>
                        <button type="button" :disabled="isLoading || currentPage === totalPages" v-on:click="goToPage(currentPage + 1)">›</button>
                        <button type="button" aria-label="最後一頁" :disabled="isLoading || currentPage === totalPages" v-on:click="goToPage(totalPages)">››</button>
                    </div>
                </div>
            </template>
        </section>
        <div v-if="legacyPreviewOpen && legacyPreviewHtml" class="report-preview-overlay" role="dialog" aria-modal="true" :aria-label="`${selectedReport.code} 列印預覽`"><div class="report-preview-actions no-print"><button class="ghost-button" type="button" v-on:click="closeLegacyPreview">關閉預覽</button><button class="primary-button" type="button" v-on:click="printLegacyPreview">列印</button></div><article class="report-preview-paper" v-html="legacyPreviewHtml"></article></div>
        <div v-if="c4PreviewOpen && c4Preview" class="c4-preview-overlay" role="dialog" aria-modal="true" aria-label="C4 列印預覽">
            <div class="c4-preview-actions no-print">
                <button class="ghost-button" type="button" v-on:click="closeC4Preview">關閉預覽</button>
                <button class="primary-button" type="button" v-on:click="printC4Preview">列印</button>
            </div>
            <article class="c4-paper">
                <header class="c4-print-header"><h1>門急診材料寄售表</h1></header>
                <div class="c4-print-meta">
                    <span>日期：{{ c4Preview.metadata.dateB }} ～ {{ c4Preview.metadata.dateE }}</span>
                    <span>使用者：{{ c4Preview.metadata.userId }}</span>
                    <span>產表：{{ c4Preview.metadata.today }}</span>
                </div>
                <p v-if="!c4Preview.rows.length" class="empty-result">查無此筆資料</p>
                <table v-else class="c4-print-table">
                    <thead><tr><th>序號</th><th>類別</th><th>材料碼</th><th>健保碼</th><th>品名</th><th>單位</th><th>批價碼</th><th>數量</th><th>科別／部門</th></tr></thead>
                    <tbody><tr v-for="row in c4Preview.rows" :key="`c4-print-${row.id}`"><td>{{ row.id }}</td><td>{{ row.type }}</td><td>{{ row.materialCode }}</td><td>{{ row.claimCode }}</td><td>{{ row.orderName }}</td><td>{{ row.unit }}</td><td>{{ row.chargeCode }}</td><td>{{ row.total }}</td><td>{{ row.sectionCode }}</td></tr></tbody>
                </table>
            </article>
        </div>
        <div v-if="c15PreviewOpen" class="c15-preview-overlay" role="dialog" aria-modal="true" aria-label="C15 列印預覽">
            <div class="c15-preview-actions no-print">
                <button class="ghost-button" type="button" v-on:click="closeC15Preview">關閉預覽</button>
                <button class="primary-button" type="button" v-on:click="printC15Preview">列印</button>
            </div>
            <div class="c15-preview-pages">
                <article v-for="page in c15PreviewPages" :key="`print-${page.type}-${page.pageNumber}`" class="c15-paper">
                    <header class="c15-print-header">
                        <h1>亞東紀念醫院</h1>
                        <h2>{{ page.title }}</h2>
                        <div class="c15-print-meta">
                            <span>資料日期：{{ displayRocDate(form.startDate) }} ～ {{ displayRocDate(form.endDate) }}</span>
                            <span>處理時間：{{ c15PrintGeneratedAt }}</span>
                            <span>頁次：{{ page.pageNumber }} / {{ page.totalPages }}</span>
                        </div>
                    </header>
                    <table class="c15-print-table">
                        <thead><tr><th>租借日期</th><th>病歷號</th><th>租借人</th><th>輔具編號</th><th>租借期限</th><th>{{ page.amount001Label }}</th><th>歸還日期</th><th>{{ page.amount002Label }}</th><th>{{ page.amount004Label }}</th><th>{{ page.amount003Label }}</th></tr></thead>
                        <tbody><tr v-for="row in page.rows" :key="`print-${page.type}-${row.encounterOrdinal}`"><td>{{ row.visitDate }}</td><td>{{ row.medicalRecordNumber }}</td><td>{{ row.patientName }}</td><td>{{ row.deviceNumber }}</td><td>{{ row.rentalPeriod }}</td><td class="amount">{{ row.rl001 }}</td><td>{{ row.returnDate }}</td><td class="amount">{{ row.rl002 }}</td><td class="amount">{{ row.rl004 }}</td><td class="amount">{{ row.rl003 }}</td></tr></tbody>
                        <tfoot v-if="page.showTotals"><tr><th colspan="5">合計</th><th class="amount">{{ page.rl001Total }}</th><th></th><th class="amount">{{ page.rl002Total }}</th><th class="amount">{{ page.rl004Total }}</th><th class="amount">{{ page.rl003Total }}</th></tr></tfoot>
                    </table>
                </article>
            </div>
        </div>
        <div v-if="c3PreviewOpen && c3Preview" class="c3-preview-overlay" role="dialog" aria-modal="true" aria-label="C3 列印預覽">
            <div class="c3-preview-actions no-print">
                <button class="ghost-button" type="button" v-on:click="closeC3Preview">關閉預覽</button>
                <button class="primary-button" type="button" v-on:click="printC3Preview">列印</button>
            </div>
            <div class="c3-preview-pages">
                <article v-for="page in c3PreviewPages" :key="`c3-print-${page.pageNumber}`" class="c3-paper">
                    <header class="c3-print-header">
                        <h1>{{ c3Preview.title }}</h1>
                        <div class="c3-print-meta">
                            <span>DateB：{{ c3Preview.dateB }}　DateE：{{ c3Preview.dateE }}</span>
                            <span>UserID：{{ c3Preview.userId }}　Today：{{ c3Preview.today }}</span>
                            <span>頁次：{{ page.pageNumber }} / {{ page.totalPages }}</span>
                        </div>
                    </header>
                    <table class="c3-print-table">
                        <thead><tr><th>診別</th><th>領用部門</th><th>部門代碼</th><th>批價碼</th><th>材料碼</th><th>材料名稱</th><th>庫別</th><th>數量</th><template v-if="Number(c3Preview.detailType) === 1"><th>醫師代碼</th><th>病歷號</th><th>病患姓名</th><th>報表日</th><th>醫師姓名</th><th>自費</th></template></tr></thead>
                        <tbody><tr v-for="(row, rowIndex) in page.rows" :key="`c3-print-${page.pageNumber}-${rowIndex}`"><td>{{ row.diagnose }}</td><td>{{ row.dispensary }}</td><td>{{ row.section }}</td><td>{{ row.chargeCode }}</td><td>{{ row.materialCode }}</td><td>{{ row.materialName }}</td><td>{{ row.inventoryType }}</td><td class="number">{{ row.totalSum }}</td><template v-if="Number(c3Preview.detailType) === 1"><td>{{ row.dctNo }}</td><td>{{ row.mrNo }}</td><td>{{ row.pName }}</td><td>{{ row.op1Date }}</td><td>{{ row.drName }}</td><td>{{ row.sPay }}</td></template></tr></tbody>
                    </table>
                </article>
            </div>
        </div>
    </div>
</template>
